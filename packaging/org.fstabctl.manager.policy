<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>csTechnologies</vendor>
  <vendor_url>https://cstevens.ca</vendor_url>
  <icon_name>fstab-manager</icon_name>
  <action id="org.fstabctl.manager.apply">
    <description>Change disk mount settings</description>
    <message>fstab Manager needs your password to change disk mount settings (/etc/fstab) or mount a drive</message>
    <icon_name>fstab-manager</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/fstab-manager</annotate>
  </action>
</policyconfig>
