def analyze(entries):
    warns = []
    for e in entries:
        if not e.enabled:
            continue
        r = resolve(e.spec)
        local = r not in ("network", "pseudo") and e.fstype != "swap"
        if r is None and not (e.has_opt("nofail") or e.has_opt("noauto")):
            warns.append(("warn", f"{e.file}: device {e.spec} is not present and the entry has no "
                                  "'nofail'; boot may stall or drop to an emergency shell"))
        elif r is None:
            warns.append(("info", f"{e.file}: device {e.spec} is not currently present"))
        if r == "network" and not (e.has_opt("_netdev") or e.has_opt("x-systemd.automount")):
            warns.append(("warn", f"{e.file}: network mount without '_netdev'; it may try to mount "
                                  "before the network is up"))
        if local and e.file not in SYSTEM_MOUNTS and not e.has_opt("nofail") and not e.has_opt("noauto") \
                and e.fstype != "tmpfs":
            warns.append(("info", f"{e.file}: consider adding 'nofail' so a missing disk can't block boot"))
        if e.has_opt("discard"):
            warns.append(("info", f"{e.file}: 'discard' is continuous TRIM; periodic fstrim.timer is "
                                  "usually preferred"))
        for o in e.opts():
            if o.startswith("credentials="):
                p = o.split("=", 1)[1]
                try:
                    if os.stat(p).st_mode & 0o077:
                        warns.append(("warn", f"{e.file}: credentials file {p} is readable by others "
                                              "(chmod 600 it)"))
                except OSError:
                    warns.append(("warn", f"{e.file}: credentials file {p} does not exist"))
        if re.match(r"^/dev/(sd|vd|hd|nvme)", e.spec) and e.file not in ("none",):
            warns.append(("info", f"{e.file}: {e.spec} uses a kernel device name which can change "
                                  "between boots; UUID= is more robust"))
    return warns


def explain(opt):
    if opt in OPT_HELP:
        return OPT_HELP[opt]
    for p, t in PREFIX_HELP.items():
        if opt.startswith(p):
            return t + f" ({opt[len(p):]})"
    return ""


def build_report(fmt, args):
    md = fmt == "markdown"
    fs = Fstab(read_fstab())
    ents = fs.entries()
    mounted, swaps = mounted_points(), swap_devices()
    devs = lsblk()
    out = []

    def h(title, level=2):
        if md:
            out.extend(["#" * level + " " + title, ""])
        else:
            out.extend([title, ("=" if level == 1 else "-") * len(title), ""])

    h(f"fstab report for {socket.gethostname()}", 1)
    meta = [("Generated", dt.datetime.now().strftime("%Y-%m-%d %H:%M")),
            ("Distribution", distro()), ("Kernel", platform.release()),
            ("fstab file", str(FSTAB_PATH)), ("Tool", f"fstabctl {VERSION}")]
    out.extend((f"- **{k}:** {v}" if md else f"{k:<13}: {v}") for k, v in meta)
    out.append("")

    statuses = [status_of(e, mounted, swaps) for _, e in ents]
    h("Summary")
    out.append(f"{len(ents)} entries: {sum(1 for _, e in ents if e.enabled)} enabled, "
               f"{sum(1 for _, e in ents if not e.enabled)} disabled; "
               f"{sum(1 for s in statuses if s in ('mounted', 'active'))} currently mounted/active; "
               f"{sum(1 for s in statuses if s == 'device missing')} with a missing device.")
    out.append("")

    h("Configured mounts")
    rows = []
    for n, ((_, e), st) in enumerate(zip(ents, statuses), 1):
        r = resolve(e.spec)
        rows.append((n, st, e.spec, r if r and r not in ("network", "pseudo") else (r or "-"),
                     e.file, e.fstype, e.options, f"{e.dump}/{e.passno}"))
    out.append(table(["#", "Status", "Device", "Resolves to", "Mount point", "Type", "Options", "Dump/Pass"],
                     rows, md))
    out.append("")

    h("What each entry does")
    for n, (_, e) in enumerate(ents, 1):
        state = "" if e.enabled else " (DISABLED)"
        out.append(f"{n}. {e.file}{state}: {e.fstype} filesystem on {e.spec}")
        for o in e.opts():
            ex = explain(o)
            out.append(f"     - {o}" + (f": {ex}" if ex else ""))
        if e.passno:
            out.append(f"     - fsck order {e.passno} at boot")
    out.append("")

    warns = analyze([e for _, e in ents])
    h("Findings")
    if warns:
        out.extend(f"- [{lvl.upper()}] {msg}" for lvl, msg in warns)
    else:
        out.append("No problems found.")
    out.append("")

    home = home_dir(args)
    links = current_links(home, args.hidden, args.depth, ents, mounted)
    if links:
        h(f"Symlinks in {home}")
        out.append(table(["Link", "Target", "Status", "Note"],
                         [(l["name"], l["target"], "ok" if l["ok"] else "BROKEN", l["note"])
                          for l in links], md))
        out.append("")

    if devs:
        h("Block devices")
        rows = [(d["path"], d["size"], d["type"], d["fstype"] or "", d["label"] or "", d["uuid"] or "",
                 ",".join(d["mounts"]),
                 ("yes" if in_fstab(d, ents) else "no") if is_candidate(d) else "-") for d in devs]
        out.append(table(["Device", "Size", "Type", "FS", "Label", "UUID", "Mounted at", "In fstab"],
                         rows, md))
        out.append("")
        free = [d for d in devs if is_candidate(d) and not d["mounts"] and not in_fstab(d, ents)]
        if free:
            h("Formatted devices not in fstab")
            out.extend(f"- {d['path']} ({d['fstype']}, {d['size']}, label: {d['label'] or '-'})"
                       for d in free)
            out.append("")

    h("Raw fstab")
    raw = fs.text().rstrip("\n").splitlines()
    out.extend(["```"] + raw + ["```"] if md else ["    " + l for l in raw])
    out.append("")
    return "\n".join(out)


def emit(text, path):
    if path:
        Path(path).write_text(text if text.endswith("\n") else text + "\n")
        own(path)
        print(f"Wrote {path}")
    else:
        print(text)


