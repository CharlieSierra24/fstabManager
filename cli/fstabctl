def home_dir(args):
    h = getattr(args, "home", None) or os.environ.get("FSTABCTL_HOME")
    return os.path.abspath(os.path.expanduser(h)) if h else real_user().pw_dir


# ---- settings (~/.config/fstabctl/settings.json, shared with fstab Manager) ----
def settings_path(home):
    return Path(home) / ".config" / "fstabctl" / "settings.json"


def load_settings(home):
    st = {"key_folders": [], "tracked_links": []}
    try:
        data = json.loads(settings_path(home).read_text())
        for k in st:
            if isinstance(data.get(k), list):
                st[k] = [str(x) for x in data[k]]
    except (OSError, ValueError):
        pass
    return st


def save_settings(home, st):
    clean = {k: sorted({v.strip().strip("/") for v in st.get(k, []) if v.strip().strip("/")})
             for k in ("key_folders", "tracked_links")}
    p = settings_path(home)
    p.parent.mkdir(parents=True, exist_ok=True)
    own(p.parent)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(clean, indent=2) + "\n")
    os.replace(tmp, p)
    own(p)


def clean_name(n):
    n = n.strip().strip("/")
    if n.startswith("~/"):
        n = n[2:]
    c = os.path.normpath(n) if n else ""
    if not c or c == "." or c.startswith("..") or os.path.isabs(n):
        die(f"'{n}' isn't a folder name inside your home folder")
    return c


def is_empty_dir(p):
    try:
        return os.path.isdir(p) and not os.path.islink(p) and not os.listdir(p)
    except OSError:
        return False


STANDARD_FOLDERS = [("DOCUMENTS", "Documents"), ("DOWNLOAD", "Downloads"), ("MUSIC", "Music"),
                    ("PICTURES", "Pictures"), ("VIDEOS", "Videos")]


def standard_folder_names(home):
    """The five standard folders under the names your desktop uses (user-dirs.dirs)."""
    xdg = {}
    try:
        for line in (Path(home) / ".config" / "user-dirs.dirs").read_text().splitlines():
            k, eq, v = line.strip().partition("=")
            if eq and k.startswith("XDG_") and k.endswith("_DIR"):
                v = v.strip('"')
                if v.startswith("$HOME/") and len(v) > 6:
                    xdg[k[4:-4]] = v[6:]
    except OSError:
        pass
    return [xdg.get(k, n) for k, n in STANDARD_FOLDERS]


def key_folders(home):
    out, seen = [], set()
    mounted = mounted_points()
    for name, custom in [(n, False) for n in standard_folder_names(home)] + \
                        [(n, True) for n in load_settings(home)["key_folders"]]:
        if name in seen:
            continue
        seen.add(name)
        p = os.path.join(home, name)
        k = dict(name=name, custom=custom, state="other", target="", ok=False, items=0, note="")
        if os.path.islink(p):
            k.update(state="link", target=os.readlink(p), ok=os.path.exists(p))
        elif not os.path.lexists(p):
            k["state"] = "missing"
        elif os.path.isdir(p):
            k["items"] = len(os.listdir(p))
            k["state"] = "empty" if k["items"] == 0 else "files"
            if p in mounted:
                k.update(state="other", note="a drive is mounted here")
        else:
            k["note"] = "a file, not a folder"
        out.append(k)
    return out


def managed_links(home):
    """What backups and bundles keep: links directly in home, plus tracked links."""
    paths = scan_links(home, False, 1)
    for n in load_settings(home)["tracked_links"]:
        p = os.path.join(home, n)
        if p not in paths and os.path.islink(p):
            paths.append(p)
    return describe_links(home, sorted(paths))


DISCOVER_SKIP = {".cache", ".var", "snap", ".local/share/Trash", ".local/share/flatpak", ".local/share/containers",
                 ".local/share/Steam", ".steam", ".mozilla", ".thunderbird", ".config/google-chrome",
                 ".config/chromium", ".config/BraveSoftware", ".config/Code", ".vscode", ".vscode-server", ".npm",
                 ".nvm", ".cargo", ".rustup", ".pyenv", ".gradle", ".m2", ".android", ".wine", ".local/lib",
                 ".local/share/virtualenvs", "go/pkg", ".docker"}
DISCOVER_SKIP_NAMES = {"node_modules", ".git", ".venv", "venv", "__pycache__", ".tox"}


def made_by_app(l):
    parts = l["name"].split("/")
    if any(p.startswith(".") for p in parts):
        return True
    return any((l["abs_target"] + "/").startswith(p) for p in
               ("/usr/", "/opt/", "/snap/", "/var/lib/", "/proc/", "/run/", "/etc/", "/nix/"))


def discover_links(home, hidden=False, max_depth=6):
    """Search home for symlinks; skip app data, other drives and (unless hidden) hidden folders."""
    home_dev = os.stat(home).st_dev
    paths, state = [], {"visited": 0, "truncated": False}

    def walk(d, lvl):
        state["visited"] += 1
        if state["visited"] > 20000 or len(paths) >= 1000:
            state["truncated"] = True
            return
        try:
            items = sorted(os.scandir(d), key=lambda x: x.name)
        except OSError:
            return
        for ent in items:
            rel = os.path.relpath(ent.path, home)
            if ent.name.startswith(".") and not hidden:
                continue
            if ent.is_symlink():
                paths.append(ent.path)
                continue
            if (not ent.is_dir(follow_symlinks=False) or lvl >= max_depth or rel in DISCOVER_SKIP
                    or ent.name in DISCOVER_SKIP_NAMES):
                continue
            try:
                if os.lstat(ent.path).st_dev != home_dev:
                    continue  # another drive mounted inside home
            except OSError:
                continue
            walk(ent.path, lvl + 1)

    walk(home, 1)
    kept = {l["name"] for l in managed_links(home)}
    tracked = set(load_settings(home)["tracked_links"])
    out = []
    for l in describe_links(home, sorted(paths)):
        l.update(kept=l["name"] in kept, tracked=l["name"] in tracked, by_app=made_by_app(l))
        out.append(l)
    return out, state["truncated"]


def cmd_link_discover(args):
    home = home_dir(args)
    found, trunc = discover_links(home, args.hidden, max(1, min(10, args.max_depth)))
    if not found:
        print("No links found.")
        return
    print(table(["LINK", "TARGET", "IN BACKUPS"],
                [("~/" + l["name"], l["target"], ("kept" if l["kept"] else "not kept")
                  + (", by an app?" if l["by_app"] else "")) for l in found]))
    if trunc:
        print("\n(stopped early: the search limit was reached)")
    print("\nKeep a link in backups and bundles with: fstabctl link track NAME")


def _track(args, track):
    home = home_dir(args)
    st = load_settings(home)
    cur = set(st["tracked_links"])
    for raw in args.names:
        n = clean_name(raw)
        if track:
            if not os.path.islink(os.path.join(home, n)):
                die(f"~/{n} is not a symlink")
            cur.add(n)
            print(f"  keep ~/{n} in backups and bundles")
        else:
            cur.discard(n)
            print(f"  stop keeping ~/{n} (the link itself is not touched)")
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    st["tracked_links"] = sorted(cur)
    save_settings(home, st)
    print("Saved.")


