    print(f"Memory: {human(st['mem_total'])}, {human(st['mem_available'])} available now\n")
    if not st["items"]:
        print("No swap is set up.")
        return
    rows = []
    for it in st["items"]:
        state = ("on" if it["active"] else "disabled" if it["entry"] and not it["enabled"]
                 else "missing" if it["missing"] else "off")
        rows.append([str(it["entry"]) if it["entry"] else "–", it["name"], it["kind"], human(it["size"]) if it["size"] else "–",
                     human(it["used"]) if it["active"] else "–", state, "in fstab" if it["entry"] else "not in fstab"])
    print(table(["#", "Swap", "Kind", "Size", "Used", "State", "fstab"], rows))


def cmd_swap_create(args):
    path = os.path.normpath(args.path)
    size = parse_swap_size(args.size)
    if args.priority is not None and not -1 <= args.priority <= 32767:
        die("--priority must be a number from -1 to 32767")
    if os.path.lexists(path):
        die(f"{path} already exists; choose another name, or resize it if it's a swap file")
    ft = check_swap_path(path, size)
    fs = Fstab(read_fstab())
    if any(e.spec == path for _, e in fs.entries()):
        die(f"{path} is already in fstab (entry for a file that doesn't exist); remove that entry first")
    print(f"Will create a {human(size)} swap file at {path} (on {ft}, {human(free_space(os.path.dirname(path)))} free there now).")
    print("  1. Make the file and set it up as swap (only root can read it)")
    print("  2. Add it to fstab, so it's used after every restart")
    print("  3. Turn it on now")
    if ft == "btrfs":
        print("Note: on btrfs, a snapshot of the subvolume holding a swap file fails. If you use snapshots (Timeshift, "
              "Snapper),\nput the swap file in a subvolume of its own, such as /swap.")
    print()
    e = swap_entry(path, args.priority)
    fs.append(e)
    _preview_fstab(fs.text())
    if not args.dry_run:
        need_root("creating swap")
    if not _ask(args, "Create the swap file?"):
        return
    err = make_swap_file(path, size, ft)
    if err:
        die(f"couldn't create the swap file: {err}")
    print(f"✓ created {path} ({human(size)})")
    try:
        write_fstab(fs.text(), f"swap create {path}", args, show=False, quiet_next=True)
    except SystemExit:
        os.unlink(path)
        print(f"Removed {path} again, because fstab couldn't be updated.")
        raise
    err = swap_on(path, e)
    if err:
        die(f"the swap file is made and in fstab, but turning it on failed ({err}); it will be used after a restart")
    print(f"✓ {path} is on. You now have {human(size)} more swap.")


def cmd_swap_resize(args):
    size = parse_swap_size(args.size)
    fs = Fstab(read_fstab())
    it, ie = swap_target(fs, args.target, args.expect)
    if it["kind"] == "zram":
        die(f"{it['name']} is compressed swap in memory (zram); change its size in /etc/systemd/zram-generator.conf")
    if it["kind"] != "file":
        die(f"{it['name']} is a partition. A partition's size can only be changed by repartitioning the disk (KDE "
            "Partition Manager or GParted, from a live USB). An easier way to get more swap: add a swap file")
    if it["missing"]:
        die(f"{it['name']} doesn't exist; remove its fstab entry, or create it again")
    path = it["name"]
    cur = area_size(path, "file")
    if size == cur:
        die(f"{path} is already {human(size)}")
    uuid, ok, readable = swap_sig(path)
    if (readable and not ok) or (not readable and not args.dry_run):
        die(f"{path} isn't set up as swap (it has no swap signature), so fstabctl won't resize it. "
            "Remove it with 'fstabctl swap remove' (the file is kept), then add a new swap file")
    ft = check_swap_path(path, size, cur)
    can_swap_off(it)
    turn_on = it["active"] or (ie is not None and ie[1].enabled)
    print(f"Will resize the swap file {path} from {human(cur)} to {human(size)}.")
    print(f"  1. {off_step(it)}" if it["active"] else "  1. (it's off now)")
    print("  2. Make it again at the new size, keeping its UUID")
    if turn_on:
        print("  3. Turn it back on")
    print("fstab doesn't change: the entry names the file, not its size.")
    if not readable:
        print(CHECK_LATER)
    hibernate_note(it, "resize it")
    if not args.dry_run:
        need_root("resizing swap")
    if not _ask(args, "Resize it?"):
        return
    e = ie[1] if ie else None
    if it["active"]:
        err = swap_off(path)
        if err:
            die(f"{err}; nothing was changed")
        print(f"✓ turned off {path}")
    os.unlink(path)
    err = make_swap_file(path, size, ft, uuid)
    if err:
        print(f"✗ couldn't make it at {human(size)}: {err}")
        if make_swap_file(path, cur, ft, uuid) is None:
            if turn_on:
                swap_on(path, e)
            die(f"resize failed; {path} was put back at {human(cur)}")
        die(f"resize failed and the old file couldn't be put back; create it again with: fstabctl swap create {path} "
            f"--size {human(cur)} (after removing its fstab entry)")
    print(f"✓ {path} is now {human(size)}")
    if turn_on:
        err = swap_on(path, e)
        if err:
            die(f"resized, but turning it on failed ({err}); it will be used after a restart")
        print(f"✓ turned on {path}")


def cmd_swap_remove(args):
    fs = Fstab(read_fstab())
    it, ie = swap_target(fs, args.target, args.expect)
    if it["kind"] == "zram":
        die(f"{it['name']} is compressed swap in memory (zram), set up by your system. To stop it, remove the "
            "zram-generator (or systemd-zram-setup) package or edit /etc/systemd/zram-generator.conf")
    can_swap_off(it)
    delete = it["kind"] == "file" and not args.keep_file and not it["missing"]
    keep_why, unchecked = "", False
    if delete:
        _, ok, readable = swap_sig(it["name"])
        if not os.path.isfile(it["name"]) or os.path.islink(it["name"]):
            delete = False
        elif not readable and args.dry_run:
            unchecked = True
        elif not ok and not it["active"]:
            # never delete a file that isn't recognisably swap: keep it and say so
            delete = False
            keep_why = (f"{it['name']} is kept: it has no swap signature, so it may not be a swap file (or it may hold "
                        f"data). If you're sure it isn't needed, delete it yourself: sudo rm {it['name']}")
    print(f"Will remove swap {it['name']} ({it['kind']}, {human(it['size'])}).")
    step = 1
    if it["active"]:
        print(f"  {step}. {off_step(it)}")
        step += 1
    if ie:
        print(f"  {step}. Take it out of fstab")
        step += 1
    if delete:
        print(f"  {step}. Delete the file, freeing {human(it['size'])}")
        if unchecked:
            print(f"     {CHECK_LATER} If it isn't one, it's kept.")
    elif keep_why:
        print(keep_why)
    elif it["kind"] == "partition":
        print("The partition itself is left as it is; reuse it or delete it with a partition editor.")
    others = [x for x in swap_state(fs.entries())["items"] if x["active"] and x["name"] != it["name"]]
    if it["active"] and not others:
        print("Note: this is your only swap. Without swap, running out of memory closes programs instead of slowing down.")
    hibernate_note(it, "remove it")
    if ie:
        fs.remove(ie[0])
        print()
        _preview_fstab(fs.text())
    if not args.dry_run:
        need_root("removing swap")
    if not _ask(args, "Remove it?"):
        return
    if it["active"]:
        err = swap_off(it["name"])
        if err:
            die(f"{err}; nothing was changed")
        print(f"✓ turned off {it['name']}")
    if ie:
        write_fstab(fs.text(), f"swap remove {it['name']}", args, show=False, quiet_next=True)
    if delete:
        os.unlink(it["name"])
        print(f"✓ deleted {it['name']}")
    elif keep_why:
        print(keep_why)


def _swap_onoff(args, on):
    fs = Fstab(read_fstab())
    it, ie = swap_target(fs, args.target, args.expect)
    if it["missing"]:
        die(f"{it['name']} isn't there")
    if on == it["active"]:
        die(f"{it['name']} is already {'on' if on else 'off'}")
    if not on:
        can_swap_off(it)
    elif it["kind"] == "file":
        _, ok, readable = swap_sig(it["name"])
        if readable and not ok:
            die(f"{it['name']} isn't set up as swap (it has no swap signature), so it can't be turned on. "
                "Remove it (the file is kept), then add a new swap file")
    verb = "on" if on else "off"
    tail = (", so it comes back on after a restart (use 'fstabctl disable' to stop that)."
            if ie and not on and ie[1].enabled else ".")
    print(f"Will turn {verb} {it['name']} now. fstab doesn't change{tail}")
    if not args.dry_run:
        need_root(f"turning swap {verb}")
    if not _ask(args, f"Turn it {verb}?"):
        return
    err = swap_on(it["name"], ie[1] if ie else None) if on else swap_off(it["name"])
    if err:
        die(err)
    print(f"✓ {it['name']} is {verb}")


def cmd_swap_on(args):
    _swap_onoff(args, True)


def cmd_swap_off(args):
    _swap_onoff(args, False)


def cmd_swap_setup(args):
    """Make a partition into swap (if it isn't already), add it to fstab and turn it on."""
    want = args.device if args.device.startswith("/") else (resolve(args.device) or args.device)
    dev = next((d for d in lsblk() if d["path"] == args.device or os.path.realpath(d["path"]) == os.path.realpath(want)), None)
    if not dev:
        die(f"no partition {args.device} found")
    if dev["type"] not in ("part", "lvm", "crypt"):
        die(f"{dev['path']} is a {dev['type']}; choose a partition")
    if dev["mounts"]:
        die(f"{dev['path']} is in use (mounted at {', '.join(dev['mounts'])})")
    if dev["fstype"] in NON_FS:
        die(f"{dev['path']} holds {dev['fstype']}; it is part of another storage setup, so fstabctl won't touch it")
    holders = Path("/sys/class/block", os.path.basename(os.path.realpath(dev["path"])), "holders")
    if holders.is_dir() and any(holders.iterdir()):
        die(f"{dev['path']} holds other volumes; fstabctl won't touch it")
    if any(os.path.realpath(a["name"]) == os.path.realpath(dev["path"]) for a in read_proc_swaps()):
        die(f"{dev['path']} is already swap and on")
    fs = Fstab(read_fstab())
    for _, e in fs.entries():
        if e.enabled and resolve(e.spec) == os.path.realpath(dev["path"]):
            die(f"{dev['path']} is already in fstab (entry for {e.file})")
    fmt = dev["fstype"] != "swap"
    if fmt and dev["fstype"] and not args.erase:
        what = dev["fstype"] + (f", label {dev['label']}" if dev["label"] else "")
        die(f"{dev['path']} holds a {what} filesystem. Making it swap erases everything on it; add --erase if that's what you want")
    print(f"Will use {dev['path']} ({dev['size']}) as swap.")
    step = 1
    if fmt:
        if dev["fstype"]:
            print(f"  {step}. ERASE it: everything on this {dev['fstype']} partition"
                  + (f" ({dev['label']})" if dev["label"] else "") + " is lost")
        else:
            print(f"  {step}. Set it up as swap (it's empty)")
        step += 1
    print(f"  {step}. Add it to fstab by UUID\n  {step + 1}. Turn it on now\n")
    spec = "UUID=(made-by-mkswap)" if fmt else f"UUID={dev['uuid']}"
    preview = Fstab(fs.text())
    preview.append(swap_entry(spec, args.priority))
    _preview_fstab(preview.text())
    if not args.dry_run:
        need_root("setting up swap")
    if not _ask(args, "Erase it and use it as swap?" if fmt and dev["fstype"] else "Use it as swap?"):
        return
    if fmt:
        r = run(["mkswap", "-f", dev["path"]])
        if r.returncode != 0:
            die(f"mkswap: {r.stderr.strip()}")
        uuid, ok = swap_header(dev["path"])
        if not ok or not uuid:
            die(f"mkswap ran but {dev['path']} has no swap UUID")
        spec = f"UUID={uuid}"
        print(f"✓ {dev['path']} is now swap")
    e = swap_entry(spec, args.priority)
    fs.append(e)
    write_fstab(fs.text(), f"swap setup {dev['path']}", args, show=False, quiet_next=True)
    err = swap_on(dev["path"], e)
    if err:
        die(f"added to fstab, but turning it on failed ({err}); it will be used after a restart")
    print(f"✓ {dev['path']} is on")


def cmd_repair(args):
    """Fix a line that can't be read: comment it out, or complete a 3-field line with standard options."""
    line_no = args.comment_out or args.add_defaults
    fs = Fstab(read_fstab())
    if not 1 <= line_no <= len(fs.lines):
        die(f"no line {line_no} in {FSTAB_PATH}")
    line = fs.lines[line_no - 1].strip()
    if args.expect and line != args.expect:
        die(f"fstab has changed since this was shown (line {line_no} is now: {line}); refresh and try again")
    try:
        parse_line(line)
        die(f"line {line_no} isn't broken; nothing to repair")
    except ValueError:
        pass
    if args.comment_out:
        fs.lines[line_no - 1] = f"# {line}    # commented out by fstabctl: this line could not be read"
    else:
        p = line.split()
        if len(p) != 3 or p[2] not in KNOWN_FS:
            die(f"line {line_no} can't be completed automatically; comment it out instead")
        opts = "defaults"
        if unescape(p[1]) not in SYSTEM_MOUNTS and p[2] != "swap":
            opts += ",nofail"
        if p[2] in ("nfs", "nfs4", "cifs"):
            opts += ",_netdev"
        fs.lines[line_no - 1] = " ".join(p) + f" {opts} 0 0"
    write_fstab(fs.text(), f"repair line {line_no}", args)


