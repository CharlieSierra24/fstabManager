# ---------------------------------------------------------------- CLI ------
def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-n", "--dry-run", action="store_true", help="show changes, write nothing")
    common.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    common.add_argument("--fstab", help="operate on this file instead of /etc/fstab")

    p = argparse.ArgumentParser(prog="fstabctl", description="Manage, back up, restore and export fstab.")
    p.add_argument("--version", action="version", version=f"fstabctl {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="command")

    linkopts = argparse.ArgumentParser(add_help=False)
    linkopts.add_argument("--home", help="home directory to manage (default: yours, even under sudo)")
    linkopts.add_argument("--depth", type=int, default=1,
                          help="how deep to look for symlinks (default 1 = directly inside home)")
    linkopts.add_argument("--hidden", action="store_true", help="include dotfiles/dot-directories")

    def add(name, fn, help_, link=False):
        s = sub.add_parser(name, parents=[common, linkopts] if link else [common],
                           help=help_, description=help_)
        s.set_defaults(fn=fn)
        return s

    add("list", cmd_list, "show fstab entries with live status")
    add("scan", cmd_scan, "show disks/partitions and which are not in fstab")

    s = add("add", cmd_add, "add an entry (interactive wizard if no device given)")
    s.add_argument("device", nargs="?", help="/dev/sdb1, UUID=..., LABEL=..., or host:/path, //host/share")
    s.add_argument("mountpoint", nargs="?")
    s.add_argument("-t", "--fstype")
    s.add_argument("-o", "--options", help="explicit mount options (overrides preset)")
    s.add_argument("-p", "--preset", choices=list(PRESETS))
    s.add_argument("--by", choices=["uuid", "label", "partuuid", "path"], default="uuid",
                   help="how to identify the device (default: uuid)")
    s.add_argument("--dump", type=int, default=0)
    s.add_argument("--passno", type=int, help="fsck order (default: 2 for ext*, else 0)")
    s.add_argument("--no-mkdir", action="store_true", help="don't create the mount point")

    expect_help = "only act if this entry's device is still SPEC (guards '#' numbers against a changed fstab)"
    s = add("remove", cmd_remove, "delete an entry")
    s.add_argument("target", help="mount point, device spec, or # from 'list'")
    s.add_argument("--force", action="store_true")
    s.add_argument("--expect", metavar="SPEC", help=expect_help)
    for name, fn, hlp in (("disable", cmd_disable, "comment out an entry (keeps it for later)"),
                          ("enable", cmd_enable, "re-enable a disabled entry")):
        s = add(name, fn, hlp)
        s.add_argument("target")
        s.add_argument("--force", action="store_true")
        s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("mount", cmd_mount, "mount entries now, without rebooting")
    s.add_argument("target", nargs="?", help="mount point, device spec, or # from 'list'")
    s.add_argument("--all", action="store_true", help="every enabled entry that should be mounted but isn't")
    s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("repair", cmd_repair, "fix a line that can't be read")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--comment-out", type=int, metavar="LINE", help="put a # in front of line LINE")
    g.add_argument("--add-defaults", type=int, metavar="LINE",
                   help="complete a 3-field line with 'defaults' (+ nofail) and 0 0")
    s.add_argument("--expect", metavar="TEXT", help="only act if the line still reads TEXT")

    s = add("set", cmd_set, "change fields of an existing entry")
    s.add_argument("target")
    s.add_argument("-o", "--options", help="replace all options")
    s.add_argument("--add-options", help="comma-separated options to add")
    s.add_argument("--remove-options", help="comma-separated options to remove")
    s.add_argument("-t", "--fstype")
    s.add_argument("--device")
    s.add_argument("--mountpoint")
    s.add_argument("--passno", type=int)
    s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("backup", cmd_backup, "save a timestamped copy of fstab")
    s.add_argument("--note", help="label for this backup")
    add("backups", cmd_backups, "list saved backups")
    s = add("diff", cmd_diff, "compare current fstab with a backup")
    s.add_argument("backup", nargs="?", default="latest")
    s = add("restore", cmd_restore, "restore fstab from a backup (current is backed up first)")
    s.add_argument("backup", nargs="?", default="latest", help="id, 'latest', or file path")

    add("verify", cmd_verify, "check fstab for errors and risky settings")
    s = add("report", cmd_report, "human-readable report of the current configuration", link=True)
    s.add_argument("-f", "--format", choices=["text", "markdown"])
    s.add_argument("-o", "--output")
    s = add("export", cmd_export, "write a portable JSON bundle (fstab entries, disk inventory, home links)",
          link=True)
    s.add_argument("-o", "--output")
    s = add("import", cmd_import, "merge a bundle into this system's fstab")
    s.add_argument("bundle")
    s.add_argument("--include-system", action="store_true", help="also import /, /boot, /boot/efi")
    s.add_argument("--skip-missing", action="store_true", help="skip entries whose device is absent "
                   "(default: add them as disabled)")
    # ---- home-folder symlinks
    lp = sub.add_parser("link", help="manage symlinks in your home folder",
                        description="Create, repoint, remove, check, back up and restore symlinks in "
                                    "your home folder (e.g. ~/Music -> /mnt/data/Music).")
    ls = lp.add_subparsers(dest="linkcmd", required=True, metavar="action")

    def ladd(name, fn, help_):
        s = ls.add_parser(name, parents=[common, linkopts], help=help_, description=help_)
        s.set_defaults(fn=fn)
        return s

    ladd("list", cmd_link_list, "show symlinks in home and whether they work")
    ladd("check", cmd_link_check, "report broken links and why (exit 1 if any)")
    s = ladd("add", cmd_link_add, "create a symlink in home pointing at TARGET")
    s.add_argument("target", help="what to link to, e.g. /mnt/data/Music")
    s.add_argument("name", nargs="?", help="link name inside home (default: basename of target)")
    s.add_argument("--adopt", action="store_true",
                   help="if NAME is a real directory, move it to TARGET first, then link back")
    s.add_argument("--force", action="store_true", help="replace an existing symlink")
    s.add_argument("--relative", action="store_true", help="create a relative link")
    s.add_argument("--mkdir-target", action="store_true", help="create TARGET if missing")
    s.add_argument("--allow-missing", action="store_true", help="allow a link to a missing target")
    s.add_argument("--replace-empty", action="store_true",
                   help="if NAME is an empty folder, replace it with the link (folders with files are never touched)")
    s = ladd("set", cmd_link_set, "repoint an existing symlink")
    s.add_argument("name")
    s.add_argument("target")
    s.add_argument("--relative", action="store_true")
    s.add_argument("--allow-missing", action="store_true")
    s = ladd("remove", cmd_link_remove, "remove symlinks (never touches real files)")
    s.add_argument("names", nargs="+")
    s.add_argument("--restore-folder", action="store_true",
                   help="put an empty local folder back where each link was")
    s = ladd("discover", cmd_link_discover, "search your home folder for links (skips app data and other drives)")
    s.add_argument("--max-depth", type=int, default=6, help="how many folders deep to search (default 6)")
    s = ladd("track", cmd_link_track, "keep these links (relative to home) in backups and bundles")
    s.add_argument("names", nargs="+")
    s = ladd("untrack", cmd_link_untrack, "stop keeping these links in backups and bundles")
    s.add_argument("names", nargs="+")
    s = ladd("folders", cmd_link_folders, "show or edit Key folders (Documents, Downloads, ... plus your own)")
    s.add_argument("action", nargs="?", default="list", choices=["list", "add", "remove"])
    s.add_argument("names", nargs="*")
    s = ladd("backup", cmd_link_backup, "snapshot current home links")
    s.add_argument("--note")
    ladd("backups", cmd_link_backups, "list link snapshots")
    s = ladd("restore", cmd_link_restore, "recreate links from a snapshot")
    s.add_argument("backup", nargs="?", default="latest")
    s.add_argument("--force", action="store_true", help="replace links that now point elsewhere")
    s = ladd("import", cmd_link_import, "recreate links from an 'export' bundle")
    s.add_argument("bundle")
    s.add_argument("--force", action="store_true")
    s.add_argument("--skip-missing", action="store_true", help="skip links whose target doesn't exist yet")

    s = add("gui", cmd_gui, "open the desktop app, fstab Manager (a separate program)")
    s.add_argument("--no-notify", action="store_true", help="no desktop notifications when a disk is plugged in")

    add("presets", cmd_presets, "list option presets for 'add'")
    return p


def main():
    global FSTAB_PATH
    args = build_parser().parse_args()
    if args.fstab:
        FSTAB_PATH = Path(args.fstab)
    elif os.environ.get("FSTABCTL_FSTAB"):
        FSTAB_PATH = Path(os.environ["FSTABCTL_FSTAB"])
    try:
        args.fn(args)
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
