def _toggle(args, enable):
    fs = Fstab(read_fstab())
    idx, e = find_expected(fs, args)
    if e.enabled == enable:
        die(f"{e.file} is already {'enabled' if enable else 'disabled'}")
    if not enable and e.file in SYSTEM_MOUNTS and not args.force:
        die(f"{e.file} is boot-critical; use --force to disable it")
    e.enabled = enable
    fs.replace(idx, e)
    write_fstab(fs.text(), f"{'enable' if enable else 'disable'} {e.file}", args)


