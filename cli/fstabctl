        plan = [("skip", n, t, "target missing") if a in ("create", "replace") and "missing" in note
                else (a, n, t, note) for a, n, t, note in plan]
    run_link_plan(home, plan, args, f"link import of {Path(args.bundle).name}",
                  {"key_folders": bundle.get("key_folders") or [], "tracked_links": bundle.get("tracked_links") or []})


