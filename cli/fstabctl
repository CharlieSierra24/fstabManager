# ----------------------------------------------------------------- helpers --
def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def ask(prompt, default=None):
    if not sys.stdin.isatty():
        die(f"need input for '{prompt}' but stdin is not a terminal; pass it as an argument")
    suffix = f" [{default}]" if default else ""
    ans = input(f"{prompt}{suffix}: ").strip()
    return ans or (default or "")


def confirm(prompt, assume_yes=False):
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        print("Not a terminal; re-run with -y to apply.", file=sys.stderr)
        return False
    return input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes")


def invoker():
    return os.environ.get("FSTABCTL_REAL_USER") or os.environ.get("SUDO_USER")


def real_user():
    name = invoker() or pwd.getpwuid(os.getuid()).pw_name
    try:
        return pwd.getpwnam(name)
    except KeyError:
        return pwd.getpwuid(os.getuid())


def own(path):
    """When running under sudo, hand backup files back to the invoking user."""
    if os.geteuid() == 0 and invoker():
        u = real_user()
        try:
            os.chown(path, u.pw_uid, u.pw_gid)
        except OSError:
            pass


def backup_dir():
    env = os.environ.get("FSTABCTL_BACKUP_DIR")
    if env:
        return Path(env)
    return Path(real_user().pw_dir) / ".local/share/fstabctl/backups"


def distro():
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return platform.system()


def unescape(s):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


def escape(s):
    return (s.replace("\\", "\\134").replace(" ", "\\040")
             .replace("\t", "\\011").replace("\n", "\\012"))


def table(headers, rows, md=False):
    rows = [[str(c) for c in r] for r in rows]
    if md:
        esc = lambda s: s.replace("|", "\\|")
        out = ["| " + " | ".join(headers) + " |", "|" + "|".join("---" for _ in headers) + "|"]
        out += ["| " + " | ".join(esc(c) for c in r) + " |" for r in rows]
        return "\n".join(out)
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(headers)]
    fmt = "  ".join("{:<%d}" % w for w in widths)
    out = [fmt.format(*headers).rstrip(), fmt.format(*("-" * w for w in widths)).rstrip()]
    out += [fmt.format(*r).rstrip() for r in rows]
    return "\n".join(out)


# ------------------------------------------------------------ fstab model --
@dataclass
class Entry:
    spec: str
    file: str
    fstype: str
    options: str = "defaults"
    dump: int = 0
    passno: int = 0
    enabled: bool = True

    def line(self):
        body = (f"{escape(self.spec):<42} {escape(self.file):<22} {self.fstype:<8} "
                f"{self.options:<44} {self.dump} {self.passno}")
        return body if self.enabled else f"{DISABLED_MARK} {body}"

    def opts(self):
        return [o for o in self.options.split(",") if o]

    def has_opt(self, name):
        return name in self.opts()


def parse_line(raw):
    """Return an Entry, None for blank/comment lines, or raise ValueError."""
    s = raw.strip()
    enabled = True
    if s.startswith(DISABLED_MARK):
        s = s[len(DISABLED_MARK):].strip()
        enabled = False
    elif not s or s.startswith("#"):
        return None
    parts = s.split()
    if not 4 <= len(parts) <= 6:
        raise ValueError(f"expected 4-6 fields, found {len(parts)}")
    try:
        dump = int(parts[4]) if len(parts) > 4 else 0
        passno = int(parts[5]) if len(parts) > 5 else 0
    except ValueError:
        raise ValueError("dump/pass fields must be integers")
    return Entry(unescape(trimq(parts[0])), unescape(trimq(parts[1])), trimq(parts[2]), trimq(parts[3]),
                 dump, passno, enabled)


def trimq(s):
    """Remove quotes around a value, as in UUID="abcd-1234" or a bare "value"."""
    key, eq, val = s.partition("=")
    if eq and key and len(val) >= 2 and val[0] in "\"'" and val[-1] == val[0]:
        return key + "=" + val[1:-1]
    if not eq and len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
        return s[1:-1]
    return s


class Fstab:
    def __init__(self, text):
        self.lines = text.splitlines()

    def entries(self):
        out = []
        for i, raw in enumerate(self.lines):
            try:
                e = parse_line(raw)
            except ValueError:
                continue
            if e:
                out.append((i, e))
        return out

    def problems(self):
        errs = []
        for i, raw in enumerate(self.lines, 1):
            try:
                parse_line(raw)
            except ValueError as ex:
                errs.append(f"line {i}: {ex}: {raw.strip()}")
        return errs

    def text(self):
        return "\n".join(self.lines) + "\n"

    def append(self, entry):
        if self.lines and self.lines[-1].strip():
            pass
        self.lines.append(entry.line())

    def replace(self, idx, entry):
        self.lines[idx] = entry.line()

    def remove(self, idx):
        del self.lines[idx]


def read_fstab():
    try:
        return FSTAB_PATH.read_text()
    except FileNotFoundError:
        return ""
    except PermissionError:
        die(f"cannot read {FSTAB_PATH}")


def validate(text):
    fs = Fstab(text)
    errors = fs.problems()
    seen = {}
    for _, e in fs.entries():
        if not e.enabled:
            continue
        if not e.file.startswith("/") and e.file not in ("none", "swap"):
            errors.append(f"{e.spec}: mount point '{e.file}' must be an absolute path")
        if e.fstype != "swap" and e.file != "none":
            if e.file in seen:
                errors.append(f"duplicate mount point {e.file} ({seen[e.file]} and {e.spec})")
            seen[e.file] = e.spec
    return errors


# ------------------------------------------------------ devices & status --
def resolve(spec):
    """Return real device path, 'network', 'pseudo', or None if missing."""
    m = re.match(r"^(UUID|LABEL|PARTUUID|PARTLABEL|ID)=(.*)$", spec)
    if m:
        base = Path("/dev/disk") / BY_DIR[m.group(1)]
        for cand in (m.group(2), m.group(2).upper(), m.group(2).lower(),
                     m.group(2).replace(" ", "\\x20")):
            p = base / cand
            if p.exists():
                return os.path.realpath(p)
        return None
    if spec.startswith("//") or (":" in spec and not spec.startswith("/")):
        return "network"
    if spec.startswith("/dev/"):
        return os.path.realpath(spec) if os.path.exists(spec) else None
    if spec.startswith("/"):
        return spec if os.path.exists(spec) else None
    return "pseudo"


def mounted_points():
    pts = set()
    try:
        for line in Path("/proc/self/mounts").read_text().splitlines():
            f = line.split()
            if len(f) > 1:
                pts.add(unescape(f[1]))
    except OSError:
        pass
    return pts


def swap_devices():
    out = set()
    try:
        for line in Path("/proc/swaps").read_text().splitlines()[1:]:
            out.add(os.path.realpath(line.split()[0]))
    except OSError:
        pass
    return out


def status_of(e, mounted, swaps):
    if not e.enabled:
        return "disabled"
    r = resolve(e.spec)
    if r is None:
        return "device missing"
    if e.fstype == "swap":
        return "active" if r in swaps else "inactive"
    return "mounted" if e.file in mounted else "not mounted"


def lsblk():
    base = "NAME,PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,PARTUUID,MODEL,ROTA,RM"
    r = None
    hook = os.environ.get("FSTABCTL_LSBLK_JSON")  # testing hook: read lsblk -J output from a file
    if hook and os.path.exists(hook):
        r = subprocess.CompletedProcess([], 0, Path(hook).read_text(), "")
    else:
        for mp in ("MOUNTPOINTS", "MOUNTPOINT"):
            r = run(["lsblk", "-J", "-o", f"{base},{mp}"])
            if r.returncode == 0 and r.stdout:
                break
        else:
            return []
    out = []

    def truthy(v):
        return str(v).lower() in ("1", "true")

    def walk(nodes, model=None):
        for n in nodes:
            if n.get("type") in ("loop", "rom") or str(n.get("name", "")).startswith("zram"):
                continue
            mps = n.get("mountpoints")
            if mps is None:
                mps = [n.get("mountpoint")]
            m = n.get("model") or model
            out.append(dict(
                path=n.get("path") or "/dev/" + n.get("name", ""), name=n.get("name", ""),
                type=n.get("type", ""), size=n.get("size") or "", fstype=n.get("fstype"),
                label=n.get("label"), uuid=n.get("uuid"), partuuid=n.get("partuuid"),
                model=(m or "").strip(), rota=truthy(n.get("rota")), rm=truthy(n.get("rm")),
                mounts=[x for x in mps if x]))
            walk(n.get("children") or [], m)

    try:
        walk(json.loads(r.stdout).get("blockdevices", []))
    except ValueError:
        return []
    return out


def is_candidate(d):
    return bool(d["fstype"]) and d["fstype"] not in NON_FS


def in_fstab(d, entries):
    real = os.path.realpath(d["path"])
    return any(e.enabled and resolve(e.spec) == real for _, e in entries)


# ----------------------------------------------------------- backups -------
def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def _id_key(path):
    """Sort key so same-second snapshots ('...-2') order after the first."""
    stem = Path(path).stem.split("-", 1)[1]
    parts = stem.split("-")
    return (parts[0] + "-" + parts[1], int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else 1)


def list_backups():
    d = backup_dir()
    out = []
    if d.is_dir():
        for meta in sorted(d.glob("fstab-*.json"), key=_id_key, reverse=True):
            try:
                m = json.loads(meta.read_text())
                m["file"] = str(meta.with_suffix(".bak"))
                out.append(m)
            except (OSError, ValueError):
                continue
    return out


def make_backup(note="", dedupe=False):
    text = read_fstab()
    h = sha(text)
    if dedupe:
        existing = list_backups()
        if existing and existing[0].get("sha256") == h:
            return existing[0]
    d = backup_dir()
    d.mkdir(parents=True, exist_ok=True)
    own(d)
    now = dt.datetime.now()
    bid = now.strftime("%Y%m%d-%H%M%S")
    n = 1
    while (d / f"fstab-{bid}.bak").exists():
        n += 1
        bid = now.strftime("%Y%m%d-%H%M%S") + f"-{n}"
    bak = d / f"fstab-{bid}.bak"
    bak.write_text(text)
    meta = dict(id=bid, created=now.isoformat(timespec="seconds"), host=socket.gethostname(),
                distro=distro(), note=note, sha256=h, entries=len(Fstab(text).entries()))
    mp = d / f"fstab-{bid}.json"
    mp.write_text(json.dumps(meta, indent=2))
    own(bak)
    own(mp)
    meta["file"] = str(bak)
    return meta


def find_backup(ref):
    backups = list_backups()
    if ref in (None, "latest"):
        if not backups:
            die(f"no backups found in {backup_dir()}")
        return backups[0]
    for b in backups:
        if b["id"] == ref or b["id"].startswith(ref):
            return b
    p = Path(ref)
    if p.is_file():
        return {"id": p.name, "file": str(p), "note": "external file"}
    die(f"no backup matching '{ref}' (try: fstabctl backups)")


# ------------------------------------------------------------ writing ------
def atomic_write(path, text):
    st = path.stat() if path.exists() else None
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".fstabctl-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if st:
            os.chmod(tmp, st.st_mode & 0o7777)
            try:
                os.chown(tmp, st.st_uid, st.st_gid)
            except OSError:
                pass
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    if shutil.which("restorecon"):
        run(["restorecon", str(path)])


def show_diff(old, new, a="current", b="proposed"):
    d = list(difflib.unified_diff(old.splitlines(), new.splitlines(), a, b, lineterm=""))
    print("\n".join(d) if d else "(no changes)")
    return bool(d)


def write_fstab(new_text, note, args, post=None, show=True, quiet_next=False):
    """Validate -> diff -> confirm -> backup -> atomic write. Returns True if written.
    show=False: the caller already showed the diff and asked (swap commands)."""
    old = read_fstab()
    if not new_text.endswith("\n"):
        new_text += "\n"
    if old == new_text:
        print("Nothing to change.")
        return False
    # Only block on problems this change introduces; pre-existing ones are left alone.
    pre_existing = set(validate(old))
    errors = [e for e in validate(new_text) if e not in pre_existing]
    if errors:
        print("Refusing to write; problems found:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        sys.exit(2)
    if show:
        show_diff(old, new_text)
        findmnt_notes(new_text)
    if args.dry_run:
        print("\n(dry run: nothing written)")
        return False
    if not os.access(FSTAB_PATH if FSTAB_PATH.exists() else FSTAB_PATH.parent, os.W_OK):
        die(f"no permission to write {FSTAB_PATH}; re-run with sudo")
    if show and not confirm("\nApply this change?", args.yes):
        print("Cancelled.")
        return False
    b = make_backup(note=f"auto: before {note}", dedupe=True)
    atomic_write(FSTAB_PATH, new_text)
    print(f"\nWritten. Previous version saved as backup {b['id']}.")
    if post:
        post()
    if not quiet_next:
        print("Next: 'sudo systemctl daemon-reload' (systemd distros), then 'sudo mount -a' to test.")
    print(f"Undo the fstab change any time with: fstabctl restore {b['id']}")
    return True


def findmnt_notes(new_text):
    if shutil.which("findmnt"):
        with tempfile.NamedTemporaryFile("w", suffix=".fstab", delete=False) as t:
            t.write(new_text)
        r = run(["findmnt", "--verify", "--tab-file", t.name])
        os.unlink(t.name)
        notes, target = [], ""
        for l in (r.stdout + r.stderr).splitlines():
            if l and not l[0].isspace():
                target = l.strip()  # findmnt groups its notes under each mount point
            if target in ("none", "swap"):
                continue  # swap lines: findmnt doesn't understand swap files; 'fstabctl swap list' reports missing swap
            if "[E]" in l or "[W]" in l:
                notes.append(l)
        if notes:
            print("\nfindmnt --verify says (advisory):")
            for l in notes:
                print("  " + l.strip())


# ---------------------------------------------------------- target lookup --
def find_expected(fs, args):
    """find_target, plus --expect SPEC: refuse if that entry's device changed since it was shown."""
    idx, e = find_target(fs, args.target)
    if getattr(args, "expect", None) and e.spec != args.expect:
        die(f"fstab has changed since this was shown (entry {args.target} is now {e.spec}); refresh and try again")
    return idx, e


def find_target(fs, target):
    ents = fs.entries()
    if target.isdigit() and 1 <= int(target) <= len(ents):
        return ents[int(target) - 1]
    hits = [(i, e) for i, e in ents if e.file == target or e.spec == target]
    if not hits:
        die(f"no entry matches '{target}' (use a mount point, device spec, or # from 'list')")
    if len(hits) > 1:
        die(f"'{target}' matches several entries; use the # from 'fstabctl list'")
    return hits[0]


# ------------------------------------------------------------ commands -----
def cmd_list(args):
    fs = Fstab(read_fstab())
    mounted, swaps = mounted_points(), swap_devices()
    rows = [(n, status_of(e, mounted, swaps), e.spec, e.file, e.fstype, e.options)
            for n, (_, e) in enumerate(fs.entries(), 1)]
    if not rows:
        print(f"No entries in {FSTAB_PATH}.")
    else:
        print(table(["#", "STATUS", "DEVICE", "MOUNT POINT", "TYPE", "OPTIONS"], rows))
    for p in fs.problems():
        print(f"warning: {p}", file=sys.stderr)


def cmd_scan(args):
    devs = lsblk()
    if not devs:
        die("lsblk not available or returned nothing")
    ents = Fstab(read_fstab()).entries()
    rows = []
    for d in devs:
        rows.append((d["path"], d["size"], d["type"], d["fstype"] or "", d["label"] or "",
                     d["uuid"] or "", ",".join(d["mounts"]),
                     ("yes" if in_fstab(d, ents) else "no") if is_candidate(d) else "-"))
    print(table(["DEVICE", "SIZE", "TYPE", "FS", "LABEL", "UUID", "MOUNTED AT", "IN FSTAB"], rows))
    free = [d for d in devs if is_candidate(d) and not d["mounts"] and not in_fstab(d, ents)]
    if free:
        print("\nFormatted but not mounted or in fstab (candidates for 'fstabctl add'):")
        for d in free:
            print(f"  {d['path']}  {d['fstype']}  {d['size']}  {d['label'] or ''}")


def pick_preset(fstype, dev):
    if fstype in ("vfat", "exfat", "ntfs", "ntfs3", "ntfs-3g"):
        return "windows"
    if fstype in ("nfs", "nfs4"):
        return "nfs"
    if fstype == "cifs":
        return "cifs"
    if dev and dev["rm"]:
        return "usb"
    if dev and not dev["rota"]:
        return "ssd"
    return "data"


def cmd_add(args):
    devs = lsblk()
    fs = Fstab(read_fstab())
    ents = fs.entries()
    wizard = args.device is None
    dev = None
    if wizard:
        cands = [d for d in devs if is_candidate(d) and not in_fstab(d, ents)]
        if not cands:
            die("no unconfigured filesystems found; pass a device/network path explicitly")
        print("Unconfigured filesystems:")
        for i, d in enumerate(cands, 1):
            print(f"  {i}) {d['path']:<16} {d['fstype']:<8} {d['size']:>7}  "
                  f"{d['label'] or '-':<14} {d['model']}")
        choice = ask("Pick a number")
        if not choice.isdigit() or not 1 <= int(choice) <= len(cands):
            die("invalid choice")
        dev = cands[int(choice) - 1]
        device_arg = dev["path"]
    else:
        device_arg = args.device

    spec, fstype = device_arg, args.fstype
    if re.match(r"^(UUID|LABEL|PARTUUID|PARTLABEL|ID)=", device_arg):
        spec = device_arg
        if not fstype:
            real = resolve(spec)
            for d in devs:
                if real and os.path.realpath(d["path"]) == real:
                    dev, fstype = d, d["fstype"]
                    break
        if not fstype:
            die(f"could not detect the filesystem for {spec}; pass the type with -t")
    elif device_arg.startswith("//") or (":" in device_arg and not device_arg.startswith("/")):
        if not fstype:
            die("network shares need -t/--fstype (e.g. nfs, nfs4, cifs)")
    else:
        if dev is None:
            real = os.path.realpath(device_arg)
            for d in devs:
                if real == os.path.realpath(d["path"]) or device_arg in (d["name"], d["uuid"], d["label"]):
                    dev = d
                    break
        if dev is None:
            die(f"'{device_arg}' is not a known block device (see: fstabctl scan)")
        ident = {"uuid": ("UUID", dev["uuid"]), "label": ("LABEL", dev["label"]),
                 "partuuid": ("PARTUUID", dev["partuuid"]),
                 "path": (None, dev["path"])}[args.by]
        if ident[0] and ident[1]:
            spec = f"{ident[0]}={ident[1]}"
        elif ident[0]:
            fallback = f"UUID={dev['uuid']}" if dev["uuid"] else dev["path"]
            print(f"note: device has no {args.by}; using {fallback}")
            spec = fallback
        else:
            spec = dev["path"]
            print("note: /dev/sdX names can change between boots; UUID is safer.")
        fstype = fstype or dev["fstype"]
        if not fstype:
            die("could not detect a filesystem; format it first or pass -t")

    if fstype == "ntfs":
        fstype = "ntfs3" if "ntfs3" in Path("/proc/filesystems").read_text() else "ntfs-3g"

    # mount point
    if fstype == "swap":
        mountpoint = "none"
    else:
        default_mp = "/mnt/" + re.sub(r"[^A-Za-z0-9._-]+", "-",
                                      (dev and (dev["label"] or dev["name"])) or "share").strip("-")
        mountpoint = args.mountpoint or (ask("Mount point", default_mp) if wizard else default_mp)
    if mountpoint != "none" and not mountpoint.startswith("/"):
        die("mount point must be an absolute path")

    # options
    preset = args.preset or pick_preset(fstype, dev)
    if wizard and not args.preset and not args.options:
        print("Presets: " + ", ".join(PRESETS))
        preset = ask("Preset", preset)
    if preset not in PRESETS:
        die(f"unknown preset '{preset}' (see: fstabctl presets)")
    u = real_user()
    options = args.options or PRESETS[preset][0].format(uid=u.pw_uid, gid=u.pw_gid)
    if fstype == "swap":
        options = args.options or "sw"
    passno = args.passno if args.passno is not None else (
        2 if fstype in ("ext2", "ext3", "ext4") and mountpoint != "/" else 0)

    entry = Entry(spec, mountpoint, fstype, options, args.dump, 0 if fstype == "swap" else passno)
    for _, e in ents:
        if e.enabled and mountpoint != "none" and e.file == mountpoint:
            die(f"{mountpoint} is already in fstab ({e.spec}); use 'set' to change it")
        if e.enabled and e.spec == spec and fstype != "swap":
            print(f"warning: {spec} already appears in fstab at {e.file}", file=sys.stderr)
    print(f"\nNew entry ({'preset: ' + preset if not args.options else 'custom options'}):")
    print("  " + entry.line() + "\n")
    fs.append(entry)

    def post():
        if mountpoint != "none" and not args.no_mkdir and not os.path.isdir(mountpoint):
            os.makedirs(mountpoint, exist_ok=True)
            print(f"Created mount point {mountpoint}")

    write_fstab(fs.text(), f"add {mountpoint}", args, post)


def cmd_remove(args):
    fs = Fstab(read_fstab())
    idx, e = find_expected(fs, args)
    if e.file in SYSTEM_MOUNTS and not args.force:
        die(f"{e.file} is a boot-critical mount; use --force if you really mean it")
    fs.remove(idx)
    write_fstab(fs.text(), f"remove {e.file}", args)


def _toggle(args, enable):
    fs = Fstab(read_fstab())
    idx, e = find_expected(fs, args)
    if e.enabled == enable:
        die(f"{e.file} is already {'enabled' if enable else 'disabled'}")
    if not enable and e.file in SYSTEM_MOUNTS and not args.force:
        die(f"{e.file} is boot-critical; use --force to disable it")
    e.enabled = enable
    fs.replace(idx, e)
    write_fstab(fs.text(), f"{'enable' if enable else 'disable'} {e.file}", args)


def cmd_enable(args):
    _toggle(args, True)


def cmd_disable(args):
    _toggle(args, False)


def cmd_set(args):
    fs = Fstab(read_fstab())
    idx, e = find_expected(fs, args)
    if args.options is not None:
        e.options = args.options
    if args.add_options:
        cur = e.opts()
        for o in args.add_options.split(","):
            if o and o not in cur:
                cur.append(o)
        e.options = ",".join(cur)
    if args.remove_options:
        drop = set(args.remove_options.split(","))
        e.options = ",".join(o for o in e.opts() if o not in drop) or "defaults"
    if args.fstype:
        e.fstype = args.fstype
    if args.device:
        e.spec = args.device
    if args.mountpoint:
        e.file = args.mountpoint
    if args.passno is not None:
        e.passno = args.passno
    fs.replace(idx, e)
    write_fstab(fs.text(), f"edit {e.file}", args)


KNOWN_FS = {"ext2", "ext3", "ext4", "xfs", "btrfs", "vfat", "exfat", "ntfs", "ntfs3", "ntfs-3g", "f2fs", "nfs",
            "nfs4", "cifs", "swap", "tmpfs", "zfs", "jfs", "reiserfs", "hfsplus"}


def cmd_mount(args):
    """Mount one entry, or with --all every entry that should be mounted but isn't (no reboot needed)."""
    if bool(args.all) == bool(args.target):
        die("mount needs one target, or --all")
    fs = Fstab(read_fstab())
    cands = fs.entries() if args.all else [find_expected(fs, args)]
    mounted = mounted_points()
    plan, skipped = [], []
    for _, e in cands:
        reason = ""
        if not e.enabled:
            reason = "disabled"
        elif e.fstype == "swap" or e.file in ("none", "swap"):
            reason = "swap, not a folder"
        elif e.file in mounted:
            reason = "already mounted"
        elif e.file in SYSTEM_MOUNTS:
            reason = "boot-critical; the system mounts it"
        elif args.all and (e.has_opt("noauto") or e.has_opt("x-systemd.automount")):
            reason = "mounts by itself when you open the folder"
        elif resolve(e.spec) is None:
            reason = "disk not connected"
        if reason:
            if not args.all:
                die(f"can't mount {e.file}: {reason}")
            skipped.append((e.file, reason))
        else:
            plan.append(e)
    if not plan:
        print("Nothing to do: every entry that should be mounted already is.")
        for f, r in skipped:
            print(f"  skipped {f} ({r})")
        return
    print("Will mount:")
    for e in plan:
        print(f"  {e.file}  ({e.spec}, {e.fstype})")
    if skipped:
        print("Skipping:")
        for f, r in skipped:
            print(f"  {f}  ({r})")
    if args.dry_run:
        print("\n(dry run: nothing mounted)")
        return
    if os.geteuid() != 0:
        die("mounting needs administrator rights; re-run with sudo")
    if not confirm("\nMount now?", args.yes):
        print("Cancelled.")
        return
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        run(["systemctl", "daemon-reload"])  # so systemd's mount units match the current fstab
    print()
    failed = 0
    for e in plan:
        os.makedirs(e.file, exist_ok=True)
        cmd = ["mount", e.file] if str(FSTAB_PATH) == "/etc/fstab" else ["mount", "--fstab", str(FSTAB_PATH), e.file]
        r = run(cmd)
        if r.returncode != 0:
            failed += 1
            print(f"✗ {e.file}: {(r.stderr + ' ' + r.stdout).strip() or 'mount failed'}")
        else:
            print(f"✓ mounted {e.file}")
    if failed:
        die(f"{failed} of {len(plan)} mounts failed")


OWNABLE_FS = {"ext2", "ext3", "ext4", "xfs", "btrfs", "f2fs", "jfs", "reiserfs", "zfs", "tmpfs", "bcachefs", "nilfs2"}
WINDOWS_FS = {"vfat", "fat", "msdos", "exfat", "ntfs", "ntfs3", "ntfs-3g"}
OWN_PROTECTED = {"/", "/boot", "/boot/efi", "/efi", "/home", "/usr", "/var", "/etc", "/opt", "/root", "/tmp", "/srv",
                 "/nix", "/snap"}


def _own_walk(root, recursive, visit):
    """Call visit(path) for root and (recursive) everything below it on the same drive; never follows links.
    Returns the folders skipped because another drive is mounted there."""
    visit(root)
    skipped = []
    if not recursive:
        return skipped
    dev = os.lstat(root).st_dev
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        keep = []
        for d in dirnames:
            p = os.path.join(dirpath, d)
            try:
                if os.lstat(p).st_dev != dev:
                    skipped.append(p)
                    continue
            except OSError:
                continue
            keep.append(d)
            visit(p)
        dirnames[:] = keep
        for f in filenames:
            visit(os.path.join(dirpath, f))
    return skipped


def cmd_own(args):
    """Make you the owner of a mounted drive's folder (--recursive: everything on the drive below it):
    `sudo chown [-R] you:you DIR`, with safety checks."""
    fs = Fstab(read_fstab())
    _, e = find_expected(fs, args)
    d = e.file
    u = real_user()
    if not e.enabled:
        die(f"{d} is disabled; enable and mount it first")
    if e.fstype == "swap" or d in ("none", "swap"):
        die(f"{e.spec} is swap, not a folder")
    if os.path.normpath(d) in OWN_PROTECTED or d in SYSTEM_MOUNTS:
        die(f"{d} is a system folder; changing its owner could break your system, so fstabctl won't do it")
    if d not in mounted_points():
        die(f"{d} isn't mounted. Mount it first (fstabctl mount {d}); otherwise the empty folder underneath would change")
    if e.fstype in WINDOWS_FS:
        die(f"{d} is {e.fstype}, which can't store Linux owners. Use the mount options instead: "
            f"fstabctl set {d} --add-options uid={u.pw_uid},gid={u.pw_gid}, then unmount and mount it again")
    if e.fstype != "auto" and e.fstype not in OWNABLE_FS:
        die(f"{d} ({e.fstype}) isn't a filesystem fstabctl changes owners on")
    if u.pw_uid == 0:
        die("can't tell which user should own it (run it with sudo from your own account)")
    counts = {"total": 0, "foreign": 0}

    def count(p):
        counts["total"] += 1
        try:
            st = os.lstat(p)
            if st.st_uid != u.pw_uid or st.st_gid != u.pw_gid:
                counts["foreign"] += 1
        except OSError:
            pass
    skipped = _own_walk(d, args.recursive, count)
    scope = "everything on the drive under it" if args.recursive else "the top folder only"
    print(f"Make {u.pw_name} (uid {u.pw_uid}) the owner of {d}: {scope}.")
    if args.recursive:
        print(f"  {counts['total']} item(s), {counts['foreign']} owned by someone else now")
        for p in skipped:
            print(f"  skipping {p}: another drive is mounted there")
    if counts["foreign"] == 0:
        print(f"Nothing to do: it already belongs to {u.pw_name}.")
        return
    print("Permissions (who may read or write) are not changed, only the owner.")
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if os.geteuid() != 0:
        die("changing the owner needs administrator rights; re-run with sudo")
    if not confirm("\nChange the owner?", args.yes):
        print("Cancelled.")
        return
    res = {"changed": 0, "failed": 0, "err": None}

    def change(p):
        try:
            st = os.lstat(p)
            if st.st_uid == u.pw_uid and st.st_gid == u.pw_gid:
                return
            os.lchown(p, u.pw_uid, u.pw_gid)
            res["changed"] += 1
        except OSError as ex:
            res["failed"] += 1
            res["err"] = res["err"] or ex
    _own_walk(d, args.recursive, change)
    print(f"\n✓ {u.pw_name} now owns {res['changed']} item(s) in {d}")
    if res["failed"]:
        die(f"{res['failed']} item(s) could not be changed (first error: {res['err']})")


# ----------------------------------------------------------------- swap ----
PROC_SWAPS = "/proc/swaps"
PROC_MEMINFO = "/proc/meminfo"
MiB, GiB = 1 << 20, 1 << 30
MIN_SWAP = 128 * MiB
KEEP_FREE = 2 * GiB          # never fill a drive to the brim with swap
SWAPOFF_SLACK = 256 * MiB    # memory left over after moving swap back into RAM
SWAP_FILE_FS = {"ext2", "ext3", "ext4", "xfs", "btrfs"}
SWAP_FORBIDDEN = ["/proc", "/sys", "/dev", "/run", "/tmp", "/boot", "/etc", "/usr", "/bin", "/sbin",
                  "/lib", "/lib32", "/lib64", "/snap", "/var/tmp"]


def human(n):
    if n >= GiB:
        v = n / GiB
        return f"{int(v)} GiB" if v == int(v) else f"{v:.1f} GiB"
    if n >= MiB:
        return f"{n // MiB} MiB"
    return f"{n // 1024} KiB"


def parse_swap_size(s):
    m = re.match(r"(?i)^\s*([0-9]+(?:\.[0-9]+)?)\s*([KMGT])(?:I?B)?\s*$", s or "")
    if not m:
        die(f"give a size like 4G or 512M (not {s!r})")
    n = int(float(m.group(1)) * {"K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}[m.group(2).upper()])
    n = n // MiB * MiB
    if n < MIN_SWAP:
        die(f"a swap file must be at least {human(MIN_SWAP)}")
    return n


def read_proc_swaps():
    out = []
    try:
        lines = Path(PROC_SWAPS).read_text().splitlines()[1:]
    except OSError:
        return out
    for l in lines:
        f = l.split()
        if len(f) < 5:
            continue
        out.append(dict(name=unescape(f[0]), kind=f[1], size=int(f[2]) * 1024, used=int(f[3]) * 1024, prio=int(f[4])))
    return out


def meminfo():
    total = avail = 0
    try:
        for l in Path(PROC_MEMINFO).read_text().splitlines():
            p = l.split()
            if p and p[0] == "MemTotal:":
                total = int(p[1]) * 1024
            elif p and p[0] == "MemAvailable:":
                avail = int(p[1]) * 1024
    except OSError:
        pass
    return total, avail


def is_swap_file_spec(spec):
    return spec.startswith("/") and not spec.startswith("/dev/")


def area_size(path, kind):
    try:
        if kind == "file":
            return os.stat(path).st_size
        return int(Path("/sys/class/block", os.path.basename(path), "size").read_text()) * 512
    except (OSError, ValueError):
        return 0


def fs_at(path):
    """(fstype, mount point) holding path."""
    p = os.path.realpath(path)
    best, best_type = "", ""
    try:
        for line in Path("/proc/self/mounts").read_text().splitlines():
            f = line.split()
            if len(f) < 3:
                continue
            mp = unescape(f[1])
            if (p == mp or mp == "/" or p.startswith(mp + "/")) and len(mp) >= len(best):
                best, best_type = mp, f[2]
    except OSError:
        pass
    return best_type, best


def free_space(d):
    try:
        st = os.statvfs(d)
        return st.f_bavail * st.f_frsize
    except OSError:
        return 0


def hibernates_to(path, is_file):
    try:
        dev = Path("/sys/power/resume").read_text().strip()
        if not dev or dev == "0:0":
            return False
        st = os.stat(path)
        did = st.st_rdev
        if is_file:
            off = Path("/sys/power/resume_offset").read_text().strip()
            if off in ("", "0"):
                return False
            did = st.st_dev
        return f"{os.major(did)}:{os.minor(did)}" == dev
    except OSError:
        return False


def swap_sig(path):
    """(uuid, ok, readable): a swap area's signature. Swap files are readable only by root, and a
    preview may run as the user, so "can't read" must not count as "not swap"."""
    try:
        with open(path, "rb") as f:
            buf = f.read(65536)
    except OSError:
        return "", False, False
    ok = any(ps <= len(buf) and buf[ps - 10:ps] == b"SWAPSPACE2" for ps in (4096, 8192, 16384, 65536))
    if not ok or len(buf) < 1052:
        return "", ok, True
    u = buf[1036:1052]
    if u == bytes(16):
        return "", True, True
    h = u.hex()
    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:]}", True, True


def swap_header(path):
    """(uuid, ok): a swap area's signature. The UUID is kept when a file is recreated."""
    uuid, ok, _ = swap_sig(path)
    return uuid, ok


CHECK_LATER = "(Only root can read it, so it's checked to be a swap file when you apply.)"


def swap_state(entries):
    total, avail = meminfo()
    active = read_proc_swaps()
    by_path = {os.path.realpath(a["name"]): a for a in active}
    items, seen = [], set()
    for n, (_, e) in enumerate(entries, 1):
        if e.fstype != "swap":
            continue
        it = dict(name=e.spec, kind="file" if is_swap_file_spec(e.spec) else "partition", size=0, used=0, prio=0,
                  active=False, entry=n, spec=e.spec, enabled=e.enabled, missing=False)
        r = resolve(e.spec)
        if r is None:
            it["missing"] = True
        else:
            if it["kind"] == "partition":
                it["name"] = r
            a = by_path.get(os.path.realpath(r))
            if a:
                it.update(active=True, size=max(a["size"], area_size(r, it["kind"])), used=a["used"], prio=a["prio"])
                seen.add(os.path.realpath(r))
            else:
                it["size"] = area_size(r, it["kind"])
        if os.path.basename(it["name"]).startswith("zram"):
            it["kind"] = "zram"
        items.append(it)
    for a in active:
        if os.path.realpath(a["name"]) in seen:
            continue
        kind = "zram" if os.path.basename(a["name"]).startswith("zram") else ("file" if a["kind"] == "file" else "partition")
        size = max(a["size"], area_size(a["name"], "file")) if kind == "file" else a["size"]
        items.append(dict(name=a["name"], kind=kind, size=size, used=a["used"], prio=a["prio"], active=True,
                          entry=0, spec="", enabled=True, missing=False))
    for it in items:
        it["hibernate"] = not it["missing"] and hibernates_to(it["name"], it["kind"] == "file")
    return dict(mem_total=total, mem_available=avail, items=items)


def swap_target(fs, target, expect=None):
    """(item, (idx, entry) or None) for a fstab entry number, path or device."""
    ents = fs.entries()
    items = swap_state(ents)["items"]
    hits = [it for it in items if (it["entry"] and str(it["entry"]) == target) or target in (it["name"], it["spec"])
            or (not it["missing"] and os.path.realpath(target) == os.path.realpath(it["name"]))]
    if not hits:
        if target.isdigit() and 1 <= int(target) <= len(ents):
            die(f"entry {target} isn't swap")
        die(f"no swap matches '{target}' (use a swap file path, device, or # from 'fstabctl swap list')")
    if len(hits) > 1:
        die(f"'{target}' matches several swap areas; use the # from 'fstabctl swap list'")
    it = hits[0]
    if expect and expect not in (it["spec"], it["name"]):
        die(f"swap has changed since this was shown ({target} is now {it['name']}); refresh and try again")
    return it, (ents[it["entry"] - 1] if it["entry"] else None)


def can_swap_off(it):
    if not it["active"] or not it["used"]:
        return
    _, avail = meminfo()
    if it["used"] + SWAPOFF_SLACK > avail:
        die(f"{it['name']} holds {human(it['used'])} right now and only {human(avail)} of memory is free, so it can't "
            "be turned off safely. Close some programs (or add another swap area first) and try again")


def off_step(it):
    if not it["used"]:
        return "Turn it off (nothing is stored in it right now)"
    return f"Turn it off (moves the {human(it['used'])} stored in it back into memory)"


def swap_entry(spec, prio=None):
    return Entry(spec, "none", "swap", "sw" + (f",pri={prio}" if prio is not None else ""), 0, 0, True)


def need_root(what):
    if os.geteuid() != 0:
        die(f"{what} needs administrator rights; re-run with sudo")


def swap_on(path, e=None):
    cmd = ["swapon"]
    for o in (e.opts() if e else []):
        if o.startswith("pri="):
            cmd += ["-p", o[4:]]
        elif o == "discard" or o.startswith("discard="):
            cmd.append("--" + o)
    r = run(cmd + [path])
    return None if r.returncode == 0 else f"swapon: {(r.stderr + ' ' + r.stdout).strip()}"


def swap_off(path):
    r = run(["swapoff", path])
    return None if r.returncode == 0 else f"swapoff: {(r.stderr + ' ' + r.stdout).strip()}"


def check_swap_path(path, size, reuse=0):
    if not path.startswith("/"):
        die("the swap file path must start with /")
    path = os.path.normpath(path)
    for p in SWAP_FORBIDDEN:
        if path == p or path.startswith(p + "/"):
            die(f"a swap file can't go in {p}; try /swapfile")
    d = os.path.dirname(path)
    if not os.path.isdir(d):
        die(f"folder {d} doesn't exist")
    ft, mp = fs_at(d)
    if ft not in SWAP_FILE_FS:
        die(f"{path} is on {ft} (mounted at {mp}); Linux can only use swap files on ext4, xfs or btrfs")
    free = free_space(d) + reuse
    if size + KEEP_FREE > free:
        die(f"not enough free space on {mp} for {human(size)} of swap: {human(free)} free, and {human(KEEP_FREE)} must stay free")
    return ft


def make_swap_file(path, size, ft, uuid=""):
    """Create path as a swap area of size bytes (keeping uuid if given). Returns an error or None."""
    def cleanup(msg):
        try:
            os.unlink(path)
        except OSError:
            pass
        return msg
    made = False
    if ft == "btrfs" and shutil.which("btrfs"):
        made = run(["btrfs", "filesystem", "mkswapfile", "--size", f"{size // MiB}m", path]).returncode == 0
        if not made and os.path.lexists(path):
            os.unlink(path)
    if not made:
        try:
            os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
        except OSError as ex:
            return str(ex)
        if ft == "btrfs":  # no copy-on-write and no compression: required for a swap file on btrfs
            r = run(["chattr", "+C", path])
            if r.returncode != 0:
                return cleanup(f"chattr +C: {r.stderr.strip()}")
        if run(["fallocate", "-l", str(size), path]).returncode != 0:
            try:
                with open(path, "wb") as f:
                    zero = bytes(MiB)
                    for _ in range(size // MiB):
                        f.write(zero)
                    os.fsync(f.fileno())
            except OSError as ex:
                return cleanup(str(ex))
    os.chmod(path, 0o600)
    try:
        os.chown(path, 0, 0)
    except OSError:
        pass
    r = run(["mkswap"] + (["-U", uuid] if uuid else []) + [path])
    if r.returncode != 0:
        return cleanup(f"mkswap: {r.stderr.strip()}")
    return None


def hibernate_note(it, what):
    if it.get("hibernate"):
        print(f"Warning: this computer hibernates to {it['name']}. After you {what}, hibernation won't work until you "
              "update the\nresume settings (resume= / resume_offset= in the boot options, then update-initramfs and update-grub).")


def _ask(args, prompt):
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return False
    if not confirm(f"\n{prompt}", args.yes):
        print("Cancelled.")
        return False
    return True


