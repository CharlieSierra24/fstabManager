def cmd_link_add(args):
    home = home_dir(args)
    target = os.path.abspath(os.path.expanduser(args.target))
    name = args.name or os.path.basename(target.rstrip("/"))
    if not name:
        die("could not derive a link name; pass NAME")
    link = link_path(home, name)
    if link == target or target.startswith(link + "/"):
        die(f"~/{name} can't link to itself or to a folder inside it ({target})")
    entries = Fstab(read_fstab()).entries()
    mnt = fstab_mount_for(target, entries)
    replacing = getattr(args, "replace_empty", False) and is_empty_dir(link) and not os.path.ismount(link)
    adopting = args.adopt and os.path.lexists(link) and not os.path.islink(link) and not replacing
    if (adopting or args.mkdir_target) and mnt and mnt.file not in mounted_points():
        die(f"{target} is under {mnt.file}, which is in fstab but not mounted. Writing now would put "
            f"data on the wrong disk (underneath the mount point).\n       Mount it first: sudo mount {mnt.file}")
    plan = []
    if os.path.islink(link):
        cur = os.readlink(link)
        if link_abs_target(link, cur) == target and not args.relative:
            print(f"~/{name} already points to {target}")
            return
        if not args.force:
            die(f"~/{name} is already a symlink to {cur}; use --force (or 'link set') to repoint it")
        plan.append(f"replace existing symlink (was -> {cur})")
    elif replacing:
        plan.append(f"replace the empty folder ~/{name} with a link")
    elif os.path.lexists(link):
        kind = "directory" if os.path.isdir(link) else "file"
        if not args.adopt:
            if getattr(args, "replace_empty", False) and kind == "directory":
                die(f"~/{name} isn't empty, so it can't be replaced by a link. Move its contents first, "
                    f"or use --adopt to move the whole folder to {target}.")
            die(f"{link} already exists as a real {kind}. Use --adopt to move it to {target} and link back.")
        if os.path.ismount(link):
            die(f"{link} is a mount point; refusing to move it")
        if os.path.lexists(target):
            die(f"{target} already exists; merge the two by hand, then re-run")
        if not os.path.isdir(os.path.dirname(target)):
            die(f"{os.path.dirname(target)} does not exist; is the disk mounted?")
        plan.append(f"MOVE {link} -> {target}  (close any apps using it first)")
    if not adopting and not os.path.exists(target):
        if args.mkdir_target:
            plan.append(f"create directory {target}")
        elif args.allow_missing:
            print(f"warning: {target} does not exist yet; the link will be broken until it does")
        else:
            die(f"{target} does not exist. Use --mkdir-target to create it, or --allow-missing.")
    src = os.path.relpath(target, os.path.dirname(link)) if args.relative else target
    plan.append(f"link ~/{name} -> {src}")
    print("Plan:")
    for p in plan:
        print("  - " + p)
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if (adopting or args.force) and not confirm("\nProceed?", args.yes):
        print("Cancelled.")
        return
    snap_before(args, home, [name], f"link add {name}")
    if args.mkdir_target and not os.path.exists(target):
        os.makedirs(target, exist_ok=True)
    if adopting:
        shutil.move(link, target)
    if replacing:
        try:
            os.rmdir(link)  # only works on an empty folder, so nothing can be lost
        except OSError as ex:
            die(f"~/{name} is no longer empty, so it was left alone: {ex}")
    make_symlink(src, link)
    print(f"Done: ~/{name} -> {src}")


def cmd_link_set(args):
    home = home_dir(args)
    if not os.path.islink(link_path(home, args.name)):
        die(f"~/{args.name} is not an existing symlink (use 'link add' to create one)")
    args.adopt, args.force, args.mkdir_target = False, True, False
    args.target, args.name = args.target, args.name
    cmd_link_add(args)


def cmd_link_remove(args):
    home = home_dir(args)
    links = []
    for name in args.names:
        link = link_path(home, name)
        if not os.path.islink(link):
            die(f"~/{name} is not a symlink; fstabctl only ever removes symlinks, never real files")
        links.append((name, link, os.readlink(link)))
    for name, _, raw in links:
        print(f"  remove ~/{name} (-> {raw})")
    if args.restore_folder:
        print("  then create an empty local folder in each link's place")
    print("The data the links point to is not touched.")
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if not confirm("\nProceed?", args.yes):
        print("Cancelled.")
        return
    snap_before(args, home, [n for n, _, _ in links], "link remove")
    for _, link, _ in links:
        os.unlink(link)
        if args.restore_folder:
            try:
                os.mkdir(link, 0o755)
                own(Path(link))
            except OSError:
                pass
    print(f"Removed {len(links)} link(s). Undo with: fstabctl link restore")


def plan_links(home, items, old_home=None, force=False):
    plan = []
    for it in items:
        name, raw = it["name"], it["target"]
        link = link_path(home, name)
        if old_home and old_home != home and (raw == old_home or raw.startswith(old_home.rstrip("/") + "/")):
            raw = home + raw[len(old_home):]
        if os.path.islink(link):
            cur = os.readlink(link)
            if cur == raw:
                plan.append(("skip", name, raw, "already correct"))
                continue
            if not force:
                plan.append(("skip", name, raw, f"currently -> {cur}; use --force to replace"))
                continue
            act = "replace"
        elif is_empty_dir(link):
            act = "replace-empty"  # e.g. a fresh install's empty ~/Documents
        elif os.path.lexists(link):
            plan.append(("skip", name, raw, "a real file/directory is in the way"))
            continue
        else:
            act = "create"
        miss = not os.path.exists(link_abs_target(link, raw))
        plan.append((act, name, raw, "target missing right now (mount disks first?)" if miss else ""))
    return plan


def run_link_plan(home, plan, args, note, settings=None):
    print(table(["ACTION", "LINK", "TARGET", "NOTE"], plan) if plan else "No links in source.")
    todo = [p for p in plan if p[0] in ("create", "replace", "replace-empty")]
    extra = bool(settings and (settings.get("key_folders") or settings.get("tracked_links")))
    if extra:
        print(f"\nAlso restores your Key folders list ({len(settings.get('key_folders', []))}) "
              f"and tracked links ({len(settings.get('tracked_links', []))}).")
    if not todo and not extra:
        print("\nNothing to do.")
        return
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if not confirm(f"\n{len(todo)} link(s) will be created/replaced. Apply?", args.yes):
        print("Cancelled.")
        return
    if todo:
        snap_before(args, home, [p[1] for p in todo], note)
    for act, name, raw, _ in todo:
        link = link_path(home, name)
        if act == "replace-empty":
            try:
                os.rmdir(link)
            except OSError:
                print(f"skipped ~/{name}: it is no longer empty")
                continue
        make_symlink(raw, link)
    if extra:
        st = load_settings(home)
        st["key_folders"] += settings.get("key_folders", [])
        st["tracked_links"] += settings.get("tracked_links", [])
        save_settings(home, st)
    print(f"Done: {len(todo)} link(s) written. Check them with: fstabctl link check")


