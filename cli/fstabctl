def fstab_mount_for(path, entries):
    """The enabled fstab entry (other than '/') whose mount point contains path."""
    best = None
    for _, e in entries:
        if not e.enabled or not e.file.startswith("/"):
            continue
        mp = e.file.rstrip("/")
        if mp and (path == mp or path.startswith(mp + "/")):
            if best is None or len(mp) > len(best.file.rstrip("/")):
                best = e
    return best


def link_abs_target(link, raw):
    return os.path.normpath(raw if os.path.isabs(raw) else os.path.join(os.path.dirname(link), raw))


def link_path(home, name):
    p = os.path.normpath(os.path.join(home, name))
    if p == home or not p.startswith(home.rstrip("/") + "/"):
        die(f"link name '{name}' must be inside {home}")
    return p


def scan_links(home, hidden=False, depth=1):
    out = []

    def walk(d, lvl):
        try:
            items = sorted(os.scandir(d), key=lambda x: x.name)
        except OSError:
            return
        for ent in items:
            if ent.name.startswith(".") and not hidden:
                continue
            if ent.is_symlink():
                out.append(ent.path)
            elif lvl < depth and ent.is_dir(follow_symlinks=False):
                walk(ent.path, lvl + 1)

    walk(home, 1)
    return out


def describe_links(home, paths, entries=None, mounted=None):
    if entries is None:
        entries = Fstab(read_fstab()).entries()
    if mounted is None:
        mounted = mounted_points()
    infos = []
    for link in paths:
        try:
            raw = os.readlink(link)
        except OSError:
            continue
        tgt = link_abs_target(link, raw)
        ok = os.path.exists(link)
        e = fstab_mount_for(tgt, entries)
        note = ""
        if e:
            up = e.file in mounted
            if ok:
                note = f"on {e.file} ({'mounted' if up else 'NOT mounted'})"
            elif not up:
                note = f"{e.file} is in fstab but not mounted (try: sudo fstabctl mount {e.file})"
            else:
                note = f"{e.file} is mounted but this path is missing"
        elif not ok:
            note = "target path does not exist"
        infos.append(dict(name=os.path.relpath(link, home), target=raw, abs_target=tgt, ok=ok, note=note))
    return infos


def current_links(home, hidden=False, depth=1, entries=None, mounted=None):
    return describe_links(home, scan_links(home, hidden, depth), entries, mounted)


def make_symlink(src, link):
    """Create or atomically replace a symlink (never touches real files/dirs)."""
    d = os.path.dirname(link)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f".fstabctl-link-{os.getpid()}")
    try:
        os.unlink(tmp)
    except OSError:
        pass
    os.symlink(src, tmp)
    try:
        os.replace(tmp, link)
    except BaseException:
        os.unlink(tmp)
        raise
    if os.geteuid() == 0 and invoker():
        u = real_user()
        os.lchown(link, u.pw_uid, u.pw_gid)


def list_link_snaps():
    d = backup_dir()
    out = []
    if d.is_dir():
        for p in sorted(d.glob("links-*.json"), key=_id_key, reverse=True):
            try:
                m = json.loads(p.read_text())
                m["file"] = str(p)
                out.append(m)
            except (OSError, ValueError):
                continue
    return out


def save_link_snap(home, links, note="", dedupe=False):
    payload = [{"name": l["name"], "target": l["target"]} for l in links]
    h = sha(json.dumps(payload, sort_keys=True))
    snaps = list_link_snaps()
    if dedupe and snaps and snaps[0].get("sha256") == h and snaps[0].get("home") == home:
        return snaps[0]
    d = backup_dir()
    d.mkdir(parents=True, exist_ok=True)
    own(d)
    now = dt.datetime.now()
    sid = now.strftime("%Y%m%d-%H%M%S")
    n = 1
    while (d / f"links-{sid}.json").exists():
        n += 1
        sid = now.strftime("%Y%m%d-%H%M%S") + f"-{n}"
    meta = dict(id=sid, created=now.isoformat(timespec="seconds"), host=socket.gethostname(),
                home=home, note=note, sha256=h, links=payload)
    p = d / f"links-{sid}.json"
    p.write_text(json.dumps(meta, indent=2))
    own(p)
    meta["file"] = str(p)
    return meta


def snap_before(args, home, names, note):
    depth = max(getattr(args, "depth", 1), max(n.count("/") + 1 for n in names))
    links = managed_links(home)
    have = {l["name"] for l in links}
    links += [l for l in current_links(home, getattr(args, "hidden", False), depth) if l["name"] not in have]
    return save_link_snap(home, links, f"auto: before {note}", dedupe=True)


def cmd_link_list(args):
    home = home_dir(args)
    links = current_links(home, args.hidden, args.depth)
    if not links:
        print(f"No symlinks found in {home} (depth {args.depth}). Try --hidden or --depth N.")
        return
    print(table(["LINK", "TARGET", "STATUS", "NOTE"],
                [(l["name"], l["target"], "ok" if l["ok"] else "BROKEN", l["note"]) for l in links]))


def cmd_link_check(args):
    home = home_dir(args)
    links = current_links(home, args.hidden, args.depth)
    bad = [l for l in links if not l["ok"]]
    print(f"{len(links)} symlink(s) in {home}, {len(bad)} broken.")
    for l in bad:
        print(f"  BROKEN  ~/{l['name']} -> {l['target']}\n          {l['note']}")
    sys.exit(1 if bad else 0)


def cmd_link_add(args):
    home = home_dir(args)
    target = os.path.abspath(os.path.expanduser(args.target))
    name = args.name or os.path.basename(target.rstrip("/"))
    if not name:
        die("could not derive a link name; pass NAME")
    link = link_path(home, name)
    if link == target or target.startswith(link + "/"):
        die(f"~/{name} can't link to itself or to a folder inside it ({target})")
    entries = Fstab(read_fstab()).entries()
    mnt = fstab_mount_for(target, entries)
    replacing = getattr(args, "replace_empty", False) and is_empty_dir(link) and not os.path.ismount(link)
    adopting = args.adopt and os.path.lexists(link) and not os.path.islink(link) and not replacing
    if (adopting or args.mkdir_target) and mnt and mnt.file not in mounted_points():
        die(f"{target} is under {mnt.file}, which is in fstab but not mounted. Writing now would put "
            f"data on the wrong disk (underneath the mount point).\n       Mount it first: sudo mount {mnt.file}")
    plan = []
    if os.path.islink(link):
        cur = os.readlink(link)
        if link_abs_target(link, cur) == target and not args.relative:
            print(f"~/{name} already points to {target}")
            return
        if not args.force:
            die(f"~/{name} is already a symlink to {cur}; use --force (or 'link set') to repoint it")
        plan.append(f"replace existing symlink (was -> {cur})")
    elif replacing:
        plan.append(f"replace the empty folder ~/{name} with a link")
    elif os.path.lexists(link):
        kind = "directory" if os.path.isdir(link) else "file"
        if not args.adopt:
            if getattr(args, "replace_empty", False) and kind == "directory":
                die(f"~/{name} isn't empty, so it can't be replaced by a link. Move its contents first, "
                    f"or use --adopt to move the whole folder to {target}.")
            die(f"{link} already exists as a real {kind}. Use --adopt to move it to {target} and link back.")
        if os.path.ismount(link):
            die(f"{link} is a mount point; refusing to move it")
        if os.path.lexists(target):
            die(f"{target} already exists; merge the two by hand, then re-run")
        if not os.path.isdir(os.path.dirname(target)):
            die(f"{os.path.dirname(target)} does not exist; is the disk mounted?")
        plan.append(f"MOVE {link} -> {target}  (close any apps using it first)")
    if not adopting and not os.path.exists(target):
        if args.mkdir_target:
            plan.append(f"create directory {target}")
        elif args.allow_missing:
            print(f"warning: {target} does not exist yet; the link will be broken until it does")
        else:
            die(f"{target} does not exist. Use --mkdir-target to create it, or --allow-missing.")
    src = os.path.relpath(target, os.path.dirname(link)) if args.relative else target
    plan.append(f"link ~/{name} -> {src}")
    print("Plan:")
    for p in plan:
        print("  - " + p)
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if (adopting or args.force) and not confirm("\nProceed?", args.yes):
        print("Cancelled.")
        return
    snap_before(args, home, [name], f"link add {name}")
    if args.mkdir_target and not os.path.exists(target):
        os.makedirs(target, exist_ok=True)
    if adopting:
        shutil.move(link, target)
    if replacing:
        try:
            os.rmdir(link)  # only works on an empty folder, so nothing can be lost
        except OSError as ex:
            die(f"~/{name} is no longer empty, so it was left alone: {ex}")
    make_symlink(src, link)
    print(f"Done: ~/{name} -> {src}")


def cmd_link_set(args):
    home = home_dir(args)
    if not os.path.islink(link_path(home, args.name)):
        die(f"~/{args.name} is not an existing symlink (use 'link add' to create one)")
    args.adopt, args.force, args.mkdir_target = False, True, False
    args.target, args.name = args.target, args.name
    cmd_link_add(args)


def cmd_link_remove(args):
    home = home_dir(args)
    links = []
    for name in args.names:
        link = link_path(home, name)
        if not os.path.islink(link):
            die(f"~/{name} is not a symlink; fstabctl only ever removes symlinks, never real files")
        links.append((name, link, os.readlink(link)))
    for name, _, raw in links:
        print(f"  remove ~/{name} (-> {raw})")
    if args.restore_folder:
        print("  then create an empty local folder in each link's place")
    print("The data the links point to is not touched.")
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if not confirm("\nProceed?", args.yes):
        print("Cancelled.")
        return
    snap_before(args, home, [n for n, _, _ in links], "link remove")
    for _, link, _ in links:
        os.unlink(link)
        if args.restore_folder:
            try:
                os.mkdir(link, 0o755)
                own(Path(link))
            except OSError:
                pass
    print(f"Removed {len(links)} link(s). Undo with: fstabctl link restore")


def plan_links(home, items, old_home=None, force=False):
    plan = []
    for it in items:
        name, raw = it["name"], it["target"]
        link = link_path(home, name)
        if old_home and old_home != home and (raw == old_home or raw.startswith(old_home.rstrip("/") + "/")):
            raw = home + raw[len(old_home):]
        if os.path.islink(link):
            cur = os.readlink(link)
            if cur == raw:
                plan.append(("skip", name, raw, "already correct"))
                continue
            if not force:
                plan.append(("skip", name, raw, f"currently -> {cur}; use --force to replace"))
                continue
            act = "replace"
        elif is_empty_dir(link):
            act = "replace-empty"  # e.g. a fresh install's empty ~/Documents
        elif os.path.lexists(link):
            plan.append(("skip", name, raw, "a real file/directory is in the way"))
            continue
        else:
            act = "create"
        miss = not os.path.exists(link_abs_target(link, raw))
        plan.append((act, name, raw, "target missing right now (mount disks first?)" if miss else ""))
    return plan


def run_link_plan(home, plan, args, note, settings=None):
    print(table(["ACTION", "LINK", "TARGET", "NOTE"], plan) if plan else "No links in source.")
    todo = [p for p in plan if p[0] in ("create", "replace", "replace-empty")]
    extra = bool(settings and (settings.get("key_folders") or settings.get("tracked_links")))
    if extra:
        print(f"\nAlso restores your Key folders list ({len(settings.get('key_folders', []))}) "
              f"and tracked links ({len(settings.get('tracked_links', []))}).")
    if not todo and not extra:
        print("\nNothing to do.")
        return
    if args.dry_run:
        print("\n(dry run: nothing changed)")
        return
    if not confirm(f"\n{len(todo)} link(s) will be created/replaced. Apply?", args.yes):
        print("Cancelled.")
        return
    if todo:
        snap_before(args, home, [p[1] for p in todo], note)
    for act, name, raw, _ in todo:
        link = link_path(home, name)
        if act == "replace-empty":
            try:
                os.rmdir(link)
            except OSError:
                print(f"skipped ~/{name}: it is no longer empty")
                continue
        make_symlink(raw, link)
    if extra:
        st = load_settings(home)
        st["key_folders"] += settings.get("key_folders", [])
        st["tracked_links"] += settings.get("tracked_links", [])
        save_settings(home, st)
    print(f"Done: {len(todo)} link(s) written. Check them with: fstabctl link check")


def cmd_link_backup(args):
    home = home_dir(args)
    s = save_link_snap(home, managed_links(home), args.note or "manual")
    print(f"Link snapshot {s['id']} saved ({len(s['links'])} links) to {s['file']}")


def cmd_link_backups(args):
    snaps = list_link_snaps()
    if not snaps:
        print(f"No link snapshots in {backup_dir()}")
        return
    print(table(["ID", "CREATED", "HOME", "LINKS", "NOTE"],
                [(s["id"], s["created"], s.get("home", ""), len(s["links"]), s.get("note", ""))
                 for s in snaps]))


def cmd_link_restore(args):
    snaps = list_link_snaps()
    if not snaps:
        die(f"no link snapshots in {backup_dir()}")
    snap = snaps[0] if args.backup == "latest" else next(
        (s for s in snaps if s["id"].startswith(args.backup)), None)
    if not snap:
        die(f"no link snapshot matching '{args.backup}' (try: fstabctl link backups)")
    home = home_dir(args)
    print(f"Restoring link snapshot {snap['id']} ({snap.get('note', '')})\n")
    run_link_plan(home, plan_links(home, snap["links"], snap.get("home"), args.force), args,
                  f"restore of {snap['id']}")


def cmd_link_import(args):
    try:
        bundle = json.loads(Path(args.bundle).read_text())
    except (OSError, ValueError) as ex:
        die(f"cannot read bundle: {ex}")
    if bundle.get("tool") != "fstabctl":
        die("not an fstabctl bundle (create one with: fstabctl export)")
    home = home_dir(args)
    plan = plan_links(home, bundle.get("links", []), bundle.get("home"), args.force)
    if args.skip_missing:
        plan = [("skip", n, t, "target missing") if a in ("create", "replace") and "missing" in note
                else (a, n, t, note) for a, n, t, note in plan]
    run_link_plan(home, plan, args, f"link import of {Path(args.bundle).name}",
                  {"key_folders": bundle.get("key_folders") or [], "tracked_links": bundle.get("tracked_links") or []})


# ------------------------------------------------------------------- GUI --
def cmd_gui(args):
    """The desktop app (fstab Manager) is a separate Go program; this just starts it."""
    here = Path(__file__).resolve().parent
    cands = [here / "fstab-manager", here / "fstabctl-gui"]
    for name in ("fstab-manager", "fstabctl-gui"):
        found = shutil.which(name)
        if found:
            cands.append(Path(found))
    extra = ["--no-notify"] if args.no_notify else []
    for c in cands:
        if c.is_file() and os.access(c, os.X_OK):
            os.execv(str(c), [str(c)] + extra)
    die("the desktop app, fstab Manager, is a separate program ('fstab-manager').\n"
        "       Install the fstab-manager package, or put the binary next to this script or in your PATH.")


# ---------------------------------------------------------------- CLI ------
def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-n", "--dry-run", action="store_true", help="show changes, write nothing")
    common.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    common.add_argument("--fstab", help="operate on this file instead of /etc/fstab")

    p = argparse.ArgumentParser(prog="fstabctl", description="Manage, back up, restore and export fstab.")
    p.add_argument("--version", action="version", version=f"fstabctl {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="command")

    linkopts = argparse.ArgumentParser(add_help=False)
    linkopts.add_argument("--home", help="home directory to manage (default: yours, even under sudo)")
    linkopts.add_argument("--depth", type=int, default=1,
                          help="how deep to look for symlinks (default 1 = directly inside home)")
    linkopts.add_argument("--hidden", action="store_true", help="include dotfiles/dot-directories")

    def add(name, fn, help_, link=False):
        s = sub.add_parser(name, parents=[common, linkopts] if link else [common],
                           help=help_, description=help_)
        s.set_defaults(fn=fn)
        return s

    add("list", cmd_list, "show fstab entries with live status")
    add("scan", cmd_scan, "show disks/partitions and which are not in fstab")

    s = add("add", cmd_add, "add an entry (interactive wizard if no device given)")
    s.add_argument("device", nargs="?", help="/dev/sdb1, UUID=..., LABEL=..., or host:/path, //host/share")
    s.add_argument("mountpoint", nargs="?")
    s.add_argument("-t", "--fstype")
    s.add_argument("-o", "--options", help="explicit mount options (overrides preset)")
    s.add_argument("-p", "--preset", choices=list(PRESETS))
    s.add_argument("--by", choices=["uuid", "label", "partuuid", "path"], default="uuid",
                   help="how to identify the device (default: uuid)")
    s.add_argument("--dump", type=int, default=0)
    s.add_argument("--passno", type=int, help="fsck order (default: 2 for ext*, else 0)")
    s.add_argument("--no-mkdir", action="store_true", help="don't create the mount point")

    expect_help = "only act if this entry's device is still SPEC (guards '#' numbers against a changed fstab)"
    s = add("remove", cmd_remove, "delete an entry")
    s.add_argument("target", help="mount point, device spec, or # from 'list'")
    s.add_argument("--force", action="store_true")
    s.add_argument("--expect", metavar="SPEC", help=expect_help)
    for name, fn, hlp in (("disable", cmd_disable, "comment out an entry (keeps it for later)"),
                          ("enable", cmd_enable, "re-enable a disabled entry")):
        s = add(name, fn, hlp)
        s.add_argument("target")
        s.add_argument("--force", action="store_true")
        s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("mount", cmd_mount, "mount entries now, without rebooting")
    s.add_argument("target", nargs="?", help="mount point, device spec, or # from 'list'")
    s.add_argument("--all", action="store_true", help="every enabled entry that should be mounted but isn't")
    s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("own", cmd_own, "make you the owner of a mounted drive's folder (like chown you:you)")
    s.add_argument("target", help="mount point, device spec, or # from 'list'")
    s.add_argument("-R", "--recursive", action="store_true", help="also every file and folder on the drive below it")
    s.add_argument("--expect", metavar="SPEC", help="only act if this entry's device is still SPEC")

    # ---- swap
    swp = sub.add_parser("swap", help="list, add, resize or remove swap files and swap partitions",
                         description="Swap files: create, resize, remove. Swap partitions: set up, turn on or off, "
                                     "remove from fstab. Every change shows a preview first.")
    ssub = swp.add_subparsers(dest="swapcmd", required=True, metavar="action")

    def sadd(name, fn, help_):
        x = ssub.add_parser(name, parents=[common], help=help_, description=help_)
        x.set_defaults(fn=fn)
        return x
    sadd("list", cmd_swap_list, "show swap areas, their size and use")
    x = sadd("create", cmd_swap_create, "make a swap file, add it to fstab and turn it on")
    x.add_argument("path", help="where the file goes, e.g. /swapfile")
    x.add_argument("--size", required=True, help="e.g. 4G or 512M")
    x.add_argument("--priority", type=int, help="swap priority (-1 to 32767; higher is used first)")
    x = sadd("resize", cmd_swap_resize, "change a swap file's size (turns it off and on again)")
    x.add_argument("target", help="swap file path or # from 'swap list'")
    x.add_argument("--size", required=True, help="new size, e.g. 8G")
    x.add_argument("--expect", metavar="SPEC", help=expect_help)
    x = sadd("remove", cmd_swap_remove, "turn swap off, take it out of fstab and delete a swap file")
    x.add_argument("target", help="swap file path, device, or # from 'swap list'")
    x.add_argument("--keep-file", action="store_true", help="don't delete the swap file")
    x.add_argument("--expect", metavar="SPEC", help=expect_help)
    for name, fn, hlp in (("on", cmd_swap_on, "turn swap on now (until the next restart)"),
                          ("off", cmd_swap_off, "turn swap off now (until the next restart)")):
        x = sadd(name, fn, hlp)
        x.add_argument("target", help="swap file path, device, or # from 'swap list'")
        x.add_argument("--expect", metavar="SPEC", help=expect_help)
    x = sadd("setup", cmd_swap_setup, "use a partition as swap: set it up, add it to fstab and turn it on")
    x.add_argument("device", help="e.g. /dev/sdb2")
    x.add_argument("--erase", action="store_true", help="allow erasing a partition that holds a filesystem")
    x.add_argument("--priority", type=int, help="swap priority (-1 to 32767)")

    s = add("repair", cmd_repair, "fix a line that can't be read")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--comment-out", type=int, metavar="LINE", help="put a # in front of line LINE")
    g.add_argument("--add-defaults", type=int, metavar="LINE",
                   help="complete a 3-field line with 'defaults' (+ nofail) and 0 0")
    s.add_argument("--expect", metavar="TEXT", help="only act if the line still reads TEXT")

    s = add("set", cmd_set, "change fields of an existing entry")
    s.add_argument("target")
    s.add_argument("-o", "--options", help="replace all options")
    s.add_argument("--add-options", help="comma-separated options to add")
    s.add_argument("--remove-options", help="comma-separated options to remove")
    s.add_argument("-t", "--fstype")
    s.add_argument("--device")
    s.add_argument("--mountpoint")
    s.add_argument("--passno", type=int)
    s.add_argument("--expect", metavar="SPEC", help=expect_help)

    s = add("backup", cmd_backup, "save a timestamped copy of fstab")
    s.add_argument("--note", help="label for this backup")
    add("backups", cmd_backups, "list saved backups")
    s = add("diff", cmd_diff, "compare current fstab with a backup")
    s.add_argument("backup", nargs="?", default="latest")
    s = add("restore", cmd_restore, "restore fstab from a backup (current is backed up first)")
    s.add_argument("backup", nargs="?", default="latest", help="id, 'latest', or file path")

    add("verify", cmd_verify, "check fstab for errors and risky settings")
    s = add("report", cmd_report, "human-readable report of the current configuration", link=True)
    s.add_argument("-f", "--format", choices=["text", "markdown"])
    s.add_argument("-o", "--output")
    s = add("export", cmd_export, "write a portable JSON bundle (fstab entries, disk inventory, home links)",
          link=True)
    s.add_argument("-o", "--output")
    s = add("import", cmd_import, "merge a bundle into this system's fstab")
    s.add_argument("bundle")
    s.add_argument("--include-system", action="store_true", help="also import /, /boot, /boot/efi")
    s.add_argument("--skip-missing", action="store_true", help="skip entries whose device is absent "
                   "(default: add them as disabled)")
    # ---- home-folder symlinks
    lp = sub.add_parser("link", help="manage symlinks in your home folder",
                        description="Create, repoint, remove, check, back up and restore symlinks in "
                                    "your home folder (e.g. ~/Music -> /mnt/data/Music).")
    ls = lp.add_subparsers(dest="linkcmd", required=True, metavar="action")

    def ladd(name, fn, help_):
        s = ls.add_parser(name, parents=[common, linkopts], help=help_, description=help_)
        s.set_defaults(fn=fn)
        return s

    ladd("list", cmd_link_list, "show symlinks in home and whether they work")
    ladd("check", cmd_link_check, "report broken links and why (exit 1 if any)")
    s = ladd("add", cmd_link_add, "create a symlink in home pointing at TARGET")
    s.add_argument("target", help="what to link to, e.g. /mnt/data/Music")
    s.add_argument("name", nargs="?", help="link name inside home (default: basename of target)")
    s.add_argument("--adopt", action="store_true",
                   help="if NAME is a real directory, move it to TARGET first, then link back")
    s.add_argument("--force", action="store_true", help="replace an existing symlink")
    s.add_argument("--relative", action="store_true", help="create a relative link")
    s.add_argument("--mkdir-target", action="store_true", help="create TARGET if missing")
    s.add_argument("--allow-missing", action="store_true", help="allow a link to a missing target")
    s.add_argument("--replace-empty", action="store_true",
                   help="if NAME is an empty folder, replace it with the link (folders with files are never touched)")
    s = ladd("set", cmd_link_set, "repoint an existing symlink")
    s.add_argument("name")
    s.add_argument("target")
    s.add_argument("--relative", action="store_true")
    s.add_argument("--allow-missing", action="store_true")
    s = ladd("remove", cmd_link_remove, "remove symlinks (never touches real files)")
    s.add_argument("names", nargs="+")
    s.add_argument("--restore-folder", action="store_true",
                   help="put an empty local folder back where each link was")
    s = ladd("discover", cmd_link_discover, "search your home folder for links (skips app data and other drives)")
    s.add_argument("--max-depth", type=int, default=6, help="how many folders deep to search (default 6)")
    s = ladd("track", cmd_link_track, "keep these links (relative to home) in backups and bundles")
    s.add_argument("names", nargs="+")
    s = ladd("untrack", cmd_link_untrack, "stop keeping these links in backups and bundles")
    s.add_argument("names", nargs="+")
    s = ladd("folders", cmd_link_folders, "show or edit Key folders (Documents, Downloads, ... plus your own)")
    s.add_argument("action", nargs="?", default="list", choices=["list", "add", "remove"])
    s.add_argument("names", nargs="*")
    s = ladd("backup", cmd_link_backup, "snapshot current home links")
    s.add_argument("--note")
    ladd("backups", cmd_link_backups, "list link snapshots")
    s = ladd("restore", cmd_link_restore, "recreate links from a snapshot")
    s.add_argument("backup", nargs="?", default="latest")
    s.add_argument("--force", action="store_true", help="replace links that now point elsewhere")
    s = ladd("import", cmd_link_import, "recreate links from an 'export' bundle")
    s.add_argument("bundle")
    s.add_argument("--force", action="store_true")
    s.add_argument("--skip-missing", action="store_true", help="skip links whose target doesn't exist yet")

    s = add("gui", cmd_gui, "open the desktop app, fstab Manager (a separate program)")
    s.add_argument("--no-notify", action="store_true", help="no desktop notifications when a disk is plugged in")

    add("presets", cmd_presets, "list option presets for 'add'")
    return p


def main():
    global FSTAB_PATH
    args = build_parser().parse_args()
    if args.fstab:
        FSTAB_PATH = Path(args.fstab)
    elif os.environ.get("FSTABCTL_FSTAB"):
        FSTAB_PATH = Path(os.environ["FSTABCTL_FSTAB"])
    try:
        args.fn(args)
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
