# ----------------------------------------------------------------- helpers --
def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def ask(prompt, default=None):
    if not sys.stdin.isatty():
        die(f"need input for '{prompt}' but stdin is not a terminal; pass it as an argument")
    suffix = f" [{default}]" if default else ""
    ans = input(f"{prompt}{suffix}: ").strip()
    return ans or (default or "")


def confirm(prompt, assume_yes=False):
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        print("Not a terminal; re-run with -y to apply.", file=sys.stderr)
        return False
    return input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes")


def invoker():
    return os.environ.get("FSTABCTL_REAL_USER") or os.environ.get("SUDO_USER")


def real_user():
    name = invoker() or pwd.getpwuid(os.getuid()).pw_name
    try:
        return pwd.getpwnam(name)
    except KeyError:
        return pwd.getpwuid(os.getuid())


def own(path):
    """When running under sudo, hand backup files back to the invoking user."""
    if os.geteuid() == 0 and invoker():
        u = real_user()
        try:
            os.chown(path, u.pw_uid, u.pw_gid)
        except OSError:
            pass


def backup_dir():
    env = os.environ.get("FSTABCTL_BACKUP_DIR")
    if env:
        return Path(env)
    return Path(real_user().pw_dir) / ".local/share/fstabctl/backups"


def distro():
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return platform.system()


def unescape(s):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


def escape(s):
    return (s.replace("\\", "\\134").replace(" ", "\\040")
             .replace("\t", "\\011").replace("\n", "\\012"))


def table(headers, rows, md=False):
    rows = [[str(c) for c in r] for r in rows]
    if md:
        esc = lambda s: s.replace("|", "\\|")
        out = ["| " + " | ".join(headers) + " |", "|" + "|".join("---" for _ in headers) + "|"]
        out += ["| " + " | ".join(esc(c) for c in r) + " |" for r in rows]
        return "\n".join(out)
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(headers)]
    fmt = "  ".join("{:<%d}" % w for w in widths)
    out = [fmt.format(*headers).rstrip(), fmt.format(*("-" * w for w in widths)).rstrip()]
    out += [fmt.format(*r).rstrip() for r in rows]
    return "\n".join(out)


# ------------------------------------------------------------ fstab model --
@dataclass
class Entry:
    spec: str
    file: str
    fstype: str
    options: str = "defaults"
    dump: int = 0
    passno: int = 0
    enabled: bool = True

    def line(self):
        body = (f"{escape(self.spec):<42} {escape(self.file):<22} {self.fstype:<8} "
                f"{self.options:<44} {self.dump} {self.passno}")
        return body if self.enabled else f"{DISABLED_MARK} {body}"

    def opts(self):
        return [o for o in self.options.split(",") if o]

    def has_opt(self, name):
        return name in self.opts()


def parse_line(raw):
    """Return an Entry, None for blank/comment lines, or raise ValueError."""
    s = raw.strip()
    enabled = True
    if s.startswith(DISABLED_MARK):
        s = s[len(DISABLED_MARK):].strip()
        enabled = False
    elif not s or s.startswith("#"):
        return None
    parts = s.split()
    if not 4 <= len(parts) <= 6:
        raise ValueError(f"expected 4-6 fields, found {len(parts)}")
    try:
        dump = int(parts[4]) if len(parts) > 4 else 0
        passno = int(parts[5]) if len(parts) > 5 else 0
    except ValueError:
        raise ValueError("dump/pass fields must be integers")
    return Entry(unescape(trimq(parts[0])), unescape(trimq(parts[1])), trimq(parts[2]), trimq(parts[3]),
                 dump, passno, enabled)


def trimq(s):
    """Remove quotes around a value, as in UUID="abcd-1234" or a bare "value"."""
    key, eq, val = s.partition("=")
    if eq and key and len(val) >= 2 and val[0] in "\"'" and val[-1] == val[0]:
        return key + "=" + val[1:-1]
    if not eq and len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
        return s[1:-1]
    return s


class Fstab:
    def __init__(self, text):
        self.lines = text.splitlines()

    def entries(self):
        out = []
        for i, raw in enumerate(self.lines):
            try:
                e = parse_line(raw)
            except ValueError:
                continue
            if e:
                out.append((i, e))
        return out

    def problems(self):
        errs = []
        for i, raw in enumerate(self.lines, 1):
            try:
                parse_line(raw)
            except ValueError as ex:
                errs.append(f"line {i}: {ex}: {raw.strip()}")
        return errs

    def text(self):
        return "\n".join(self.lines) + "\n"

    def append(self, entry):
        if self.lines and self.lines[-1].strip():
            pass
        self.lines.append(entry.line())

    def replace(self, idx, entry):
        self.lines[idx] = entry.line()

    def remove(self, idx):
        del self.lines[idx]


def read_fstab():
    try:
        return FSTAB_PATH.read_text()
    except FileNotFoundError:
        return ""
    except PermissionError:
        die(f"cannot read {FSTAB_PATH}")


def validate(text):
    fs = Fstab(text)
    errors = fs.problems()
    seen = {}
    for _, e in fs.entries():
        if not e.enabled:
            continue
        if not e.file.startswith("/") and e.file not in ("none", "swap"):
            errors.append(f"{e.spec}: mount point '{e.file}' must be an absolute path")
        if e.fstype != "swap" and e.file != "none":
            if e.file in seen:
                errors.append(f"duplicate mount point {e.file} ({seen[e.file]} and {e.spec})")
            seen[e.file] = e.spec
    return errors


# ------------------------------------------------------ devices & status --
def resolve(spec):
    """Return real device path, 'network', 'pseudo', or None if missing."""
    m = re.match(r"^(UUID|LABEL|PARTUUID|PARTLABEL|ID)=(.*)$", spec)
    if m:
        base = Path("/dev/disk") / BY_DIR[m.group(1)]
        for cand in (m.group(2), m.group(2).upper(), m.group(2).lower(),
                     m.group(2).replace(" ", "\\x20")):
            p = base / cand
            if p.exists():
                return os.path.realpath(p)
        return None
    if spec.startswith("//") or (":" in spec and not spec.startswith("/")):
        return "network"
    if spec.startswith("/dev/"):
        return os.path.realpath(spec) if os.path.exists(spec) else None
    if spec.startswith("/"):
        return spec if os.path.exists(spec) else None
    return "pseudo"


def mounted_points():
    pts = set()
    try:
        for line in Path("/proc/self/mounts").read_text().splitlines():
            f = line.split()
            if len(f) > 1:
                pts.add(unescape(f[1]))
    except OSError:
        pass
    return pts


def swap_devices():
    out = set()
    try:
        for line in Path("/proc/swaps").read_text().splitlines()[1:]:
            out.add(os.path.realpath(line.split()[0]))
    except OSError:
        pass
    return out


def status_of(e, mounted, swaps):
    if not e.enabled:
        return "disabled"
    r = resolve(e.spec)
    if r is None:
        return "device missing"
    if e.fstype == "swap":
        return "active" if r in swaps else "inactive"
    return "mounted" if e.file in mounted else "not mounted"


def lsblk():
    base = "NAME,PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,PARTUUID,MODEL,ROTA,RM"
    r = None
    for mp in ("MOUNTPOINTS", "MOUNTPOINT"):
        r = run(["lsblk", "-J", "-o", f"{base},{mp}"])
        if r.returncode == 0 and r.stdout:
            break
    else:
        return []
    out = []

    def truthy(v):
        return str(v).lower() in ("1", "true")

    def walk(nodes, model=None):
        for n in nodes:
            if n.get("type") in ("loop", "rom") or str(n.get("name", "")).startswith("zram"):
                continue
            mps = n.get("mountpoints")
            if mps is None:
                mps = [n.get("mountpoint")]
            m = n.get("model") or model
            out.append(dict(
                path=n.get("path") or "/dev/" + n.get("name", ""), name=n.get("name", ""),
                type=n.get("type", ""), size=n.get("size") or "", fstype=n.get("fstype"),
                label=n.get("label"), uuid=n.get("uuid"), partuuid=n.get("partuuid"),
                model=(m or "").strip(), rota=truthy(n.get("rota")), rm=truthy(n.get("rm")),
                mounts=[x for x in mps if x]))
            walk(n.get("children") or [], m)

    try:
        walk(json.loads(r.stdout).get("blockdevices", []))
    except ValueError:
        return []
    return out


def is_candidate(d):
    return bool(d["fstype"]) and d["fstype"] not in NON_FS


def in_fstab(d, entries):
    real = os.path.realpath(d["path"])
    return any(e.enabled and resolve(e.spec) == real for _, e in entries)


# ----------------------------------------------------------- backups -------
def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def _id_key(path):
    """Sort key so same-second snapshots ('...-2') order after the first."""
    stem = Path(path).stem.split("-", 1)[1]
    parts = stem.split("-")
    return (parts[0] + "-" + parts[1], int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else 1)


def list_backups():
    d = backup_dir()
    out = []
    if d.is_dir():
        for meta in sorted(d.glob("fstab-*.json"), key=_id_key, reverse=True):
            try:
                m = json.loads(meta.read_text())
                m["file"] = str(meta.with_suffix(".bak"))
                out.append(m)
            except (OSError, ValueError):
                continue
    return out


def make_backup(note="", dedupe=False):
    text = read_fstab()
    h = sha(text)
    if dedupe:
        existing = list_backups()
        if existing and existing[0].get("sha256") == h:
            return existing[0]
    d = backup_dir()
    d.mkdir(parents=True, exist_ok=True)
    own(d)
    now = dt.datetime.now()
    bid = now.strftime("%Y%m%d-%H%M%S")
    n = 1
    while (d / f"fstab-{bid}.bak").exists():
        n += 1
        bid = now.strftime("%Y%m%d-%H%M%S") + f"-{n}"
    bak = d / f"fstab-{bid}.bak"
    bak.write_text(text)
    meta = dict(id=bid, created=now.isoformat(timespec="seconds"), host=socket.gethostname(),
                distro=distro(), note=note, sha256=h, entries=len(Fstab(text).entries()))
    mp = d / f"fstab-{bid}.json"
    mp.write_text(json.dumps(meta, indent=2))
    own(bak)
    own(mp)
    meta["file"] = str(bak)
    return meta


def find_backup(ref):
    backups = list_backups()
    if ref in (None, "latest"):
        if not backups:
            die(f"no backups found in {backup_dir()}")
        return backups[0]
    for b in backups:
        if b["id"] == ref or b["id"].startswith(ref):
            return b
    p = Path(ref)
    if p.is_file():
        return {"id": p.name, "file": str(p), "note": "external file"}
    die(f"no backup matching '{ref}' (try: fstabctl backups)")


# ------------------------------------------------------------ writing ------
def atomic_write(path, text):
    st = path.stat() if path.exists() else None
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".fstabctl-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if st:
            os.chmod(tmp, st.st_mode & 0o7777)
            try:
                os.chown(tmp, st.st_uid, st.st_gid)
            except OSError:
                pass
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    if shutil.which("restorecon"):
        run(["restorecon", str(path)])


def show_diff(old, new, a="current", b="proposed"):
    d = list(difflib.unified_diff(old.splitlines(), new.splitlines(), a, b, lineterm=""))
    print("\n".join(d) if d else "(no changes)")
    return bool(d)


def write_fstab(new_text, note, args, post=None):
    """Validate -> diff -> confirm -> backup -> atomic write. Returns True if written."""
    old = read_fstab()
    if not new_text.endswith("\n"):
        new_text += "\n"
    if old == new_text:
        print("Nothing to change.")
        return False
    # Only block on problems this change introduces; pre-existing ones are left alone.
    pre_existing = set(validate(old))
    errors = [e for e in validate(new_text) if e not in pre_existing]
    if errors:
        print("Refusing to write; problems found:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        sys.exit(2)
    show_diff(old, new_text)
    if shutil.which("findmnt"):
        with tempfile.NamedTemporaryFile("w", suffix=".fstab", delete=False) as t:
            t.write(new_text)
        r = run(["findmnt", "--verify", "--tab-file", t.name])
        os.unlink(t.name)
        notes = [l for l in (r.stdout + r.stderr).splitlines() if "[E]" in l or "[W]" in l]
        if notes:
            print("\nfindmnt --verify says (advisory):")
            for l in notes:
                print("  " + l.strip())
    if args.dry_run:
        print("\n(dry run: nothing written)")
        return False
    if not os.access(FSTAB_PATH if FSTAB_PATH.exists() else FSTAB_PATH.parent, os.W_OK):
        die(f"no permission to write {FSTAB_PATH}; re-run with sudo")
    if not confirm("\nApply this change?", args.yes):
        print("Cancelled.")
        return False
    b = make_backup(note=f"auto: before {note}", dedupe=True)
    atomic_write(FSTAB_PATH, new_text)
    print(f"\nWritten. Previous version saved as backup {b['id']}.")
    if post:
        post()
    print("Next: 'sudo systemctl daemon-reload' (systemd distros), then 'sudo mount -a' to test.")
    print(f"Undo any time with: fstabctl restore {b['id']}")
    return True


# ---------------------------------------------------------- target lookup --
def find_expected(fs, args):
    """find_target, plus --expect SPEC: refuse if that entry's device changed since it was shown."""
    idx, e = find_target(fs, args.target)
    if getattr(args, "expect", None) and e.spec != args.expect:
        die(f"fstab has changed since this was shown (entry {args.target} is now {e.spec}); refresh and try again")
    return idx, e


def find_target(fs, target):
    ents = fs.entries()
    if target.isdigit() and 1 <= int(target) <= len(ents):
        return ents[int(target) - 1]
    hits = [(i, e) for i, e in ents if e.file == target or e.spec == target]
    if not hits:
        die(f"no entry matches '{target}' (use a mount point, device spec, or # from 'list')")
    if len(hits) > 1:
        die(f"'{target}' matches several entries; use the # from 'fstabctl list'")
    return hits[0]


# ------------------------------------------------------------ commands -----
def cmd_list(args):
    fs = Fstab(read_fstab())
    mounted, swaps = mounted_points(), swap_devices()
    rows = [(n, status_of(e, mounted, swaps), e.spec, e.file, e.fstype, e.options)
            for n, (_, e) in enumerate(fs.entries(), 1)]
    if not rows:
        print(f"No entries in {FSTAB_PATH}.")
    else:
        print(table(["#", "STATUS", "DEVICE", "MOUNT POINT", "TYPE", "OPTIONS"], rows))
    for p in fs.problems():
        print(f"warning: {p}", file=sys.stderr)


def cmd_scan(args):
    devs = lsblk()
    if not devs:
        die("lsblk not available or returned nothing")
    ents = Fstab(read_fstab()).entries()
    rows = []
    for d in devs:
        rows.append((d["path"], d["size"], d["type"], d["fstype"] or "", d["label"] or "",
                     d["uuid"] or "", ",".join(d["mounts"]),
                     ("yes" if in_fstab(d, ents) else "no") if is_candidate(d) else "-"))
    print(table(["DEVICE", "SIZE", "TYPE", "FS", "LABEL", "UUID", "MOUNTED AT", "IN FSTAB"], rows))
    free = [d for d in devs if is_candidate(d) and not d["mounts"] and not in_fstab(d, ents)]
    if free:
        print("\nFormatted but not mounted or in fstab (candidates for 'fstabctl add'):")
        for d in free:
            print(f"  {d['path']}  {d['fstype']}  {d['size']}  {d['label'] or ''}")


def pick_preset(fstype, dev):
    if fstype in ("vfat", "exfat", "ntfs", "ntfs3", "ntfs-3g"):
        return "windows"
    if fstype in ("nfs", "nfs4"):
        return "nfs"
    if fstype == "cifs":
        return "cifs"
    if dev and dev["rm"]:
        return "usb"
    if dev and not dev["rota"]:
        return "ssd"
    return "data"


def cmd_add(args):
    devs = lsblk()
    fs = Fstab(read_fstab())
    ents = fs.entries()
    wizard = args.device is None
    dev = None
    if wizard:
        cands = [d for d in devs if is_candidate(d) and not in_fstab(d, ents)]
        if not cands:
            die("no unconfigured filesystems found; pass a device/network path explicitly")
        print("Unconfigured filesystems:")
        for i, d in enumerate(cands, 1):
            print(f"  {i}) {d['path']:<16} {d['fstype']:<8} {d['size']:>7}  "
                  f"{d['label'] or '-':<14} {d['model']}")
        choice = ask("Pick a number")
        if not choice.isdigit() or not 1 <= int(choice) <= len(cands):
            die("invalid choice")
        dev = cands[int(choice) - 1]
        device_arg = dev["path"]
    else:
        device_arg = args.device

    spec, fstype = device_arg, args.fstype
    if re.match(r"^(UUID|LABEL|PARTUUID|PARTLABEL|ID)=", device_arg):
        spec = device_arg
        if not fstype:
            real = resolve(spec)
            for d in devs:
                if real and os.path.realpath(d["path"]) == real:
                    dev, fstype = d, d["fstype"]
                    break
        if not fstype:
            die(f"could not detect the filesystem for {spec}; pass the type with -t")
    elif device_arg.startswith("//") or (":" in device_arg and not device_arg.startswith("/")):
        if not fstype:
            die("network shares need -t/--fstype (e.g. nfs, nfs4, cifs)")
    else:
        if dev is None:
            real = os.path.realpath(device_arg)
            for d in devs:
                if real == os.path.realpath(d["path"]) or device_arg in (d["name"], d["uuid"], d["label"]):
                    dev = d
                    break
        if dev is None:
            die(f"'{device_arg}' is not a known block device (see: fstabctl scan)")
        ident = {"uuid": ("UUID", dev["uuid"]), "label": ("LABEL", dev["label"]),
                 "partuuid": ("PARTUUID", dev["partuuid"]),
                 "path": (None, dev["path"])}[args.by]
        if ident[0] and ident[1]:
            spec = f"{ident[0]}={ident[1]}"
        elif ident[0]:
            fallback = f"UUID={dev['uuid']}" if dev["uuid"] else dev["path"]
            print(f"note: device has no {args.by}; using {fallback}")
            spec = fallback
        else:
            spec = dev["path"]
            print("note: /dev/sdX names can change between boots; UUID is safer.")
        fstype = fstype or dev["fstype"]
        if not fstype:
            die("could not detect a filesystem; format it first or pass -t")

    if fstype == "ntfs":
        fstype = "ntfs3" if "ntfs3" in Path("/proc/filesystems").read_text() else "ntfs-3g"

    # mount point
    if fstype == "swap":
        mountpoint = "none"
    else:
        default_mp = "/mnt/" + re.sub(r"[^A-Za-z0-9._-]+", "-",
                                      (dev and (dev["label"] or dev["name"])) or "share").strip("-")
        mountpoint = args.mountpoint or (ask("Mount point", default_mp) if wizard else default_mp)
    if mountpoint != "none" and not mountpoint.startswith("/"):
        die("mount point must be an absolute path")

    # options
    preset = args.preset or pick_preset(fstype, dev)
    if wizard and not args.preset and not args.options:
        print("Presets: " + ", ".join(PRESETS))
        preset = ask("Preset", preset)
    if preset not in PRESETS:
        die(f"unknown preset '{preset}' (see: fstabctl presets)")
    u = real_user()
    options = args.options or PRESETS[preset][0].format(uid=u.pw_uid, gid=u.pw_gid)
    if fstype == "swap":
        options = args.options or "sw"
    passno = args.passno if args.passno is not None else (
        2 if fstype in ("ext2", "ext3", "ext4") and mountpoint != "/" else 0)

    entry = Entry(spec, mountpoint, fstype, options, args.dump, 0 if fstype == "swap" else passno)
    for _, e in ents:
        if e.enabled and mountpoint != "none" and e.file == mountpoint:
            die(f"{mountpoint} is already in fstab ({e.spec}); use 'set' to change it")
        if e.enabled and e.spec == spec and fstype != "swap":
            print(f"warning: {spec} already appears in fstab at {e.file}", file=sys.stderr)
    print(f"\nNew entry ({'preset: ' + preset if not args.options else 'custom options'}):")
    print("  " + entry.line() + "\n")
    fs.append(entry)

    def post():
        if mountpoint != "none" and not args.no_mkdir and not os.path.isdir(mountpoint):
            os.makedirs(mountpoint, exist_ok=True)
            print(f"Created mount point {mountpoint}")

    write_fstab(fs.text(), f"add {mountpoint}", args, post)


