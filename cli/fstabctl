def cmd_import(args):
    try:
        bundle = json.loads(Path(args.bundle).read_text())
    except (OSError, ValueError) as ex:
        die(f"cannot read bundle: {ex}")
    if bundle.get("tool") != "fstabctl":
        die("not an fstabctl bundle (create one with: fstabctl export)")
    fs = Fstab(read_fstab())
    cur = [e for _, e in fs.entries()]
    cur_mps = {e.file for e in cur if e.enabled}
    cur_specs = {e.spec for e in cur}
    devs = lsblk()
    old_by_uuid = {d["uuid"]: d for d in bundle.get("devices", []) if d.get("uuid")}
    plan, to_add, mkdirs = [], [], []

    for raw in bundle.get("entries", []):
        e = Entry(**{k: raw[k] for k in Entry.__dataclass_fields__ if k in raw})
        why = None
        if e.file in SYSTEM_MOUNTS and not args.include_system:
            plan.append(("skip", e, "system mount (use --include-system to import)"))
            continue
        if e.fstype != "swap" and e.file in cur_mps:
            plan.append(("skip", e, "mount point already in fstab"))
            continue
        if e.fstype == "swap" and e.spec in cur_specs:
            plan.append(("skip", e, "swap already configured"))
            continue
        if resolve(e.spec) is None:
            label = None
            m = re.match(r"^(UUID|PARTUUID)=(.*)$", e.spec)
            if m and m.group(2) in old_by_uuid:
                label = old_by_uuid[m.group(2)].get("label")
            elif e.spec.startswith("LABEL="):
                label = e.spec[6:]
            matches = [d for d in devs if label and d["label"] == label and d["fstype"]]
            if len(matches) == 1 and matches[0]["uuid"]:
                e.spec = f"UUID={matches[0]['uuid']}"
                plan.append(("add", e, f"re-linked by label '{label}' -> {matches[0]['path']}"))
            elif args.skip_missing:
                plan.append(("skip", e, "device not present on this system"))
                continue
            else:
                e.enabled = False
                plan.append(("add-disabled", e, "device not present; kept as disabled entry"))
        else:
            plan.append(("add", e, "device found"))
        to_add.append(e)
        if e.enabled and e.file.startswith("/") and e.fstype != "swap":
            mkdirs.append(e.file)

    print(table(["ACTION", "MOUNT POINT", "DEVICE", "WHY"],
                [(a, e.file, e.spec, w) for a, e, w in plan]))
    print()
    if not to_add:
        print("Nothing to import.")
        return
    for e in to_add:
        fs.append(e)

    def post():
        for d in mkdirs:
            if not os.path.isdir(d):
                os.makedirs(d, exist_ok=True)
                print(f"Created mount point {d}")
        if bundle.get("links"):
            print(f"This bundle also has {len(bundle['links'])} home-folder link(s). Once your disks "
                  f"are mounted run: fstabctl link import {args.bundle}")

    write_fstab(fs.text(), f"import of {Path(args.bundle).name}", args, post)


