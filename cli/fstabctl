def cmd_mount(args):
    """Mount one entry, or with --all every entry that should be mounted but isn't (no reboot needed)."""
    if bool(args.all) == bool(args.target):
        die("mount needs one target, or --all")
    fs = Fstab(read_fstab())
    cands = fs.entries() if args.all else [find_expected(fs, args)]
    mounted = mounted_points()
    plan, skipped = [], []
    for _, e in cands:
        reason = ""
        if not e.enabled:
            reason = "disabled"
        elif e.fstype == "swap" or e.file in ("none", "swap"):
            reason = "swap, not a folder"
        elif e.file in mounted:
            reason = "already mounted"
        elif e.file in SYSTEM_MOUNTS:
            reason = "boot-critical; the system mounts it"
        elif args.all and (e.has_opt("noauto") or e.has_opt("x-systemd.automount")):
            reason = "mounts by itself when you open the folder"
        elif resolve(e.spec) is None:
            reason = "disk not connected"
        if reason:
            if not args.all:
                die(f"can't mount {e.file}: {reason}")
            skipped.append((e.file, reason))
        else:
            plan.append(e)
    if not plan:
        print("Nothing to do: every entry that should be mounted already is.")
        for f, r in skipped:
            print(f"  skipped {f} ({r})")
        return
    print("Will mount:")
    for e in plan:
        print(f"  {e.file}  ({e.spec}, {e.fstype})")
    if skipped:
        print("Skipping:")
        for f, r in skipped:
            print(f"  {f}  ({r})")
    if args.dry_run:
        print("\n(dry run: nothing mounted)")
        return
    if os.geteuid() != 0:
        die("mounting needs administrator rights; re-run with sudo")
    if not confirm("\nMount now?", args.yes):
        print("Cancelled.")
        return
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        run(["systemctl", "daemon-reload"])  # so systemd's mount units match the current fstab
    print()
    failed = 0
    for e in plan:
        os.makedirs(e.file, exist_ok=True)
        cmd = ["mount", e.file] if str(FSTAB_PATH) == "/etc/fstab" else ["mount", "--fstab", str(FSTAB_PATH), e.file]
        r = run(cmd)
        if r.returncode != 0:
            failed += 1
            print(f"✗ {e.file}: {(r.stderr + ' ' + r.stdout).strip() or 'mount failed'}")
        else:
            print(f"✓ mounted {e.file}")
    if failed:
        die(f"{failed} of {len(plan)} mounts failed")


def cmd_repair(args):
    """Fix a line that can't be read: comment it out, or complete a 3-field line with standard options."""
    line_no = args.comment_out or args.add_defaults
    fs = Fstab(read_fstab())
    if not 1 <= line_no <= len(fs.lines):
        die(f"no line {line_no} in {FSTAB_PATH}")
    line = fs.lines[line_no - 1].strip()
    if args.expect and line != args.expect:
        die(f"fstab has changed since this was shown (line {line_no} is now: {line}); refresh and try again")
    try:
        parse_line(line)
        die(f"line {line_no} isn't broken; nothing to repair")
    except ValueError:
        pass
    if args.comment_out:
        fs.lines[line_no - 1] = f"# {line}    # commented out by fstabctl: this line could not be read"
    else:
        p = line.split()
        if len(p) != 3 or p[2] not in KNOWN_FS:
            die(f"line {line_no} can't be completed automatically; comment it out instead")
        opts = "defaults"
        if unescape(p[1]) not in SYSTEM_MOUNTS and p[2] != "swap":
            opts += ",nofail"
        if p[2] in ("nfs", "nfs4", "cifs"):
            opts += ",_netdev"
        fs.lines[line_no - 1] = " ".join(p) + f" {opts} 0 0"
    write_fstab(fs.text(), f"repair line {line_no}", args)


