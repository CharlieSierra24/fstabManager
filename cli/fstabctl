#!/usr/bin/env python3
"""
fstabctl - manage, back up, restore, and export /etc/fstab, plus the
symlinks in your home folder that point at those disks.

Single file, Python 3.8+, standard library only. Works on any systemd or
non-systemd Linux distro that has util-linux (lsblk / findmnt).

Typical use:
    fstabctl gui                        # opens the desktop app, fstab Manager
    fstabctl scan                       # what disks/partitions exist?
    sudo fstabctl add                   # interactive wizard
    sudo fstabctl add /dev/sdb1 /mnt/data --preset ssd
    sudo fstabctl backup --note "before reinstall"
    fstabctl report -o fstab-report.md  # human-readable report
    fstabctl export -o fstab-bundle.json  # portable bundle for a new install
    sudo fstabctl import fstab-bundle.json   # on the rebuilt system

Home-folder symlinks (no sudo needed):
    fstabctl link list                          # symlinks in ~ and whether they work
    fstabctl link add /mnt/data/Music           # creates ~/Music -> /mnt/data/Music
    fstabctl link add /mnt/data/Documents --adopt   # moves existing ~/Documents there, links back
    fstabctl link check                         # find broken links (and why)
    fstabctl link import fstab-bundle.json      # recreate your links after a rebuild

Every change is validated, shown as a diff, and preceded by an automatic
backup. Nothing is written without confirmation (or -y).
"""
from __future__ import annotations

