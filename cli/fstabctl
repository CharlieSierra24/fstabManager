        (s for s in snaps if s["id"].startswith(args.backup)), None)
    if not snap:
        die(f"no link snapshot matching '{args.backup}' (try: fstabctl link backups)")
    home = home_dir(args)
    print(f"Restoring link snapshot {snap['id']} ({snap.get('note', '')})\n")
    run_link_plan(home, plan_links(home, snap["links"], snap.get("home"), args.force), args,
                  f"restore of {snap['id']}")


def cmd_link_import(args):
    try:
        bundle = json.loads(Path(args.bundle).read_text())
    except (OSError, ValueError) as ex:
        die(f"cannot read bundle: {ex}")
    if bundle.get("tool") != "fstabctl":
        die("not an fstabctl bundle (create one with: fstabctl export)")
