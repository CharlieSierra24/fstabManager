def fstab_mount_for(path, entries):
    """The enabled fstab entry (other than '/') whose mount point contains path."""
    best = None
    for _, e in entries:
        if not e.enabled or not e.file.startswith("/"):
            continue
        mp = e.file.rstrip("/")
        if mp and (path == mp or path.startswith(mp + "/")):
            if best is None or len(mp) > len(best.file.rstrip("/")):
                best = e
    return best


def link_abs_target(link, raw):
    return os.path.normpath(raw if os.path.isabs(raw) else os.path.join(os.path.dirname(link), raw))


def link_path(home, name):
    p = os.path.normpath(os.path.join(home, name))
    if p == home or not p.startswith(home.rstrip("/") + "/"):
        die(f"link name '{name}' must be inside {home}")
    return p


def scan_links(home, hidden=False, depth=1):
    out = []

    def walk(d, lvl):
        try:
            items = sorted(os.scandir(d), key=lambda x: x.name)
        except OSError:
            return
        for ent in items:
            if ent.name.startswith(".") and not hidden:
                continue
            if ent.is_symlink():
                out.append(ent.path)
            elif lvl < depth and ent.is_dir(follow_symlinks=False):
                walk(ent.path, lvl + 1)

    walk(home, 1)
    return out


def describe_links(home, paths, entries=None, mounted=None):
    if entries is None:
        entries = Fstab(read_fstab()).entries()
    if mounted is None:
        mounted = mounted_points()
    infos = []
    for link in paths:
        try:
            raw = os.readlink(link)
        except OSError:
            continue
        tgt = link_abs_target(link, raw)
        ok = os.path.exists(link)
        e = fstab_mount_for(tgt, entries)
        note = ""
        if e:
            up = e.file in mounted
            if ok:
                note = f"on {e.file} ({'mounted' if up else 'NOT mounted'})"
            elif not up:
                note = f"{e.file} is in fstab but not mounted (try: sudo fstabctl mount {e.file})"
            else:
                note = f"{e.file} is mounted but this path is missing"
        elif not ok:
            note = "target path does not exist"
        infos.append(dict(name=os.path.relpath(link, home), target=raw, abs_target=tgt, ok=ok, note=note))
    return infos


def current_links(home, hidden=False, depth=1, entries=None, mounted=None):
    return describe_links(home, scan_links(home, hidden, depth), entries, mounted)


def make_symlink(src, link):
    """Create or atomically replace a symlink (never touches real files/dirs)."""
    d = os.path.dirname(link)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f".fstabctl-link-{os.getpid()}")
    try:
        os.unlink(tmp)
    except OSError:
        pass
    os.symlink(src, tmp)
    try:
        os.replace(tmp, link)
    except BaseException:
        os.unlink(tmp)
        raise
    if os.geteuid() == 0 and invoker():
        u = real_user()
        os.lchown(link, u.pw_uid, u.pw_gid)


def list_link_snaps():
    d = backup_dir()
    out = []
    if d.is_dir():
        for p in sorted(d.glob("links-*.json"), key=_id_key, reverse=True):
            try:
                m = json.loads(p.read_text())
                m["file"] = str(p)
                out.append(m)
            except (OSError, ValueError):
                continue
    return out


def save_link_snap(home, links, note="", dedupe=False):
    payload = [{"name": l["name"], "target": l["target"]} for l in links]
    h = sha(json.dumps(payload, sort_keys=True))
    snaps = list_link_snaps()
    if dedupe and snaps and snaps[0].get("sha256") == h and snaps[0].get("home") == home:
        return snaps[0]
    d = backup_dir()
    d.mkdir(parents=True, exist_ok=True)
    own(d)
    now = dt.datetime.now()
    sid = now.strftime("%Y%m%d-%H%M%S")
    n = 1
    while (d / f"links-{sid}.json").exists():
        n += 1
        sid = now.strftime("%Y%m%d-%H%M%S") + f"-{n}"
    meta = dict(id=sid, created=now.isoformat(timespec="seconds"), host=socket.gethostname(),
                home=home, note=note, sha256=h, links=payload)
    p = d / f"links-{sid}.json"
    p.write_text(json.dumps(meta, indent=2))
    own(p)
    meta["file"] = str(p)
    return meta


def snap_before(args, home, names, note):
    depth = max(getattr(args, "depth", 1), max(n.count("/") + 1 for n in names))
    links = managed_links(home)
    have = {l["name"] for l in links}
    links += [l for l in current_links(home, getattr(args, "hidden", False), depth) if l["name"] not in have]
    return save_link_snap(home, links, f"auto: before {note}", dedupe=True)


def cmd_link_list(args):
